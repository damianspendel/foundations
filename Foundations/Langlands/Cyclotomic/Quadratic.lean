import Foundations.Langlands.Cyclotomic.Degree
import Foundations.Langlands.Cyclotomic.Galois

/-!
# The quadratic subfield `ℚ(√p*)` of `ℚ(ζ_p)`

The group `(ℤ/p)ˣ` has even order `p - 1`, and its squares form a subgroup of index `2`. Gauss's
computation `g² = p*` produces the matching quadratic field `ℚ(√p*) = ℚ(g) ⊆ ℚ(ζ_p)`. Since
`σ_a(g) = (a/p) g` (`galAut_gaussSum`), the automorphisms fixing `ℚ(√p*)` are exactly the `σ_a`
with `a` a square:

* **`σ_a` fixes `ℚ(√p*)` pointwise iff `a` is a quadratic residue mod `p`**
  (`galAut_fixes_sqrtField_iff`).
* **`√p*` is irrational** (`gaussSum_not_rat`). For `p ≡ 3 (mod 4)` this holds because
  `p* < 0` is not a rational square. For `p ≡ 1 (mod 4)` it is the irrationality of `√p`, proved
  by comparing `p`-adic valuations in `a² = p b²`. So `ℚ(√p*)` is a proper extension of `ℚ`.
* **The fixed field of the squares is `ℚ(√p*)`** (`fixedField_squares`). We list the squares
  as `σ_{(i+1)²}`, `i < (p-1)/2`. By Artin's theorem the fixed field `F` has
  `[ℚ(ζ_p) : F] = (p-1)/2`, so `[F : ℚ] = 2` by the tower law and `[ℚ(ζ_p) : ℚ] = p - 1`. The
  field `ℚ(√p*) ⊆ F` is not `ℚ`, so `[F : ℚ(√p*)] = 1` and the two fields coincide.
-/

namespace Foundations.Langlands

open Foundations.Algebra Foundations.Algebra.Polynomial Foundations.NumberTheory
open Foundations.Algebra.Subfield

/-- The complex numbers of Part II. -/
local notation "ℂ" => Foundations.Numbers.C

section Quadratic

variable {p : Nat} (hp : IsPrime p) (hodd : p % 2 = 1)

include hp hodd in
/-- `√p*` (the Gauss sum) is algebraic over `ℚ`: a root of `x² - p*`. -/
theorem gaussSum_isAlgebraic : IsAlgebraic Qc (gaussSum p (zeta p)) := by
  refine ⟨binomial (Int.cast (pstar p)) 1, binomial_ne_zero (Qc.isField C.isField).1 _ 1, ?_⟩
  unfold aeval
  rw [mapPoly_binomial, eval_binomial]
  show 1 * gaussSum p (zeta p) * gaussSum p (zeta p) + -((Int.cast (pstar p) : Qc)).1 = 0
  rw [Ring.one_mul, gaussSum_sq_complex hp hodd, Subfield.coe_intCast]
  exact Ring.add_neg_cancel _

/-- **The quadratic field `ℚ(√p*)`** inside `ℂ`, generated by the Gauss sum. -/
noncomputable def sqrtField : Subfield ℂ :=
  adjoin C.isField Qc (gaussSum p (zeta p)) (gaussSum_isAlgebraic hp hodd)

/-- `ℚ(√p*) ⊆ ℚ(ζ_p)`. -/
theorem sqrtField_le : (sqrtField hp hodd).le (cycloField hp) :=
  adjoin_le _ _ _ _ (Qc_le_cycloField hp) (gaussSum_mem hp)

/-- `ℚ ⊆ ℚ(√p*)`. -/
theorem Qc_le_sqrtField : Qc.le (sqrtField hp hodd) := le_adjoin _ _ _ _

include hp hodd in
/-- `-g ≠ g`, i.e. `(-1) · g = g` is impossible: the Gauss sum is non-zero in characteristic `0`. -/
theorem neg_one_mul_gaussSum_ne : (icast (-1 : Int) : ℂ) * gaussSum p (zeta p) ≠ gaussSum p (zeta p) := by
  intro h1
  have hg0 := gaussSum_ne_zero hp hodd
  have h1' : -1 * gaussSum p (zeta p) = gaussSum p (zeta p) := h1
  have h3 : (icast (2 : Int) : ℂ) * gaussSum p (zeta p) = 0 := by
    show ((1 : ℂ) + 1) * _ = _
    generalize gaussSum p (zeta p) = g at h1' ⊢
    grind
  rcases C.isDomain.2 _ _ h3 with h4 | h4
  · exact absurd (C.charZero 2 h4) (by decide)
  · exact hg0 h4

/-- For `p ∤ a`, `(a/p) = 1` exactly when `a` is a quadratic residue. -/
theorem legendre_eq_one_iff {a : Nat} (ha : ¬ p ∣ a) :
    Foundations.Algebra.legendre a p = 1 ↔ IsQR a p := by
  classical
  unfold Foundations.Algebra.legendre
  simp only [ha, ↓reduceIte]
  by_cases h : IsQR a p
  · simp [h]
  · simp [h]

include hodd in
/-- **`σ_a` fixes `ℚ(√p*)` exactly for the squares.** For `p ∤ a`, the automorphism `σ_a` of
`ℚ(ζ_p)` fixes every element of `ℚ(√p*)` if and only if `a` is a quadratic residue mod `p`. -/
theorem galAut_fixes_sqrtField_iff {a : Nat} (ha : ¬ p ∣ a) :
    (∀ x : cycloField hp, x.1 ∈ sqrtField hp hodd → (galAut hp ha).toFun x = x) ↔ IsQR a p := by
  rw [← legendre_eq_one_iff ha]
  constructor
  · intro h
    have h1 := congrArg Subtype.val (h (gaussK hp) (mem_adjoin_self _ _ _ _))
    rw [galAut_gaussSum hp hodd] at h1
    rcases legendre_cases hp hodd ha with ⟨hl, _⟩ | ⟨hl, _⟩
    · exact hl
    · rw [hl] at h1; exact absurd h1 (neg_one_mul_gaussSum_ne hp hodd)
  · intro hl x hx
    have hg : (galAut hp ha).toFun (gaussK hp) = gaussK hp := by
      apply Subtype.ext
      rw [galAut_gaussSum hp hodd, hl]
      exact Ring.one_mul _
    have hL := adjoin_le C.isField Qc (gaussSum p (zeta p)) (gaussSum_isAlgebraic hp hodd)
      (M := fixedField (cycloField hp) (fun φ => φ = galAut hp ha))
      (le_fixedField (Qc_le_cycloField hp) _) ⟨gaussSum_mem hp, fun φ hφ => by rw [hφ]; exact hg⟩
    obtain ⟨_, hfix⟩ := hL x.1 hx
    exact hfix _ rfl

/-- From `g² = P` and `g b = a`, `P b² = a²` (in any commutative ring). -/
theorem cast_sq_of {Ω : Type} [CommRing Ω] {g : Ω} {P a b : Int} (hg : g * g = (P : Ω))
    (hab : g * (b : Ω) = (a : Ω)) : ((P * (b * b) : Int) : Ω) = ((a * a : Int) : Ω) := by
  rw [Lean.Grind.Ring.intCast_mul, Lean.Grind.Ring.intCast_mul, Lean.Grind.Ring.intCast_mul,
    ← hab, ← hg]
  grind

include hp hodd in
/-- **`√p*` is irrational**: the Gauss sum does not lie in `ℚ`. -/
theorem gaussSum_not_rat : gaussSum p (zeta p) ∉ Qc := by
  rintro ⟨a, b, hb, hab⟩
  have h2 := hp.1
  -- `p* b² = a²` in `ℤ`
  have hsq : pstar p * (b * b) = a * a := by
    exact C.charZero.cast_inj (cast_sq_of (gaussSum_sq_complex hp hodd) hab)
  unfold pstar at hsq
  rw [neg_one_pow_int] at hsq
  have hbb : 0 < b * b := by
    rcases Int.lt_or_gt_of_ne hb with h | h
    · exact Int.mul_pos_of_neg_of_neg h h
    · exact Int.mul_pos h h
  split at hsq
  · -- `p b² = a²`: compare `p`-adic valuations
    rw [Int.one_mul] at hsq
    have hP : Foundations.Numbers.Arith.Prime p := ⟨hp.1, hp.2⟩
    have hA : 0 < a.natAbs := by
      have : a ≠ 0 := by intro h; rw [h, Int.mul_zero] at hsq; have := Int.mul_pos (by omega : (0:Int) < p) hbb; omega
      omega
    have hB : 0 < b.natAbs := by omega
    have hN : p * (b.natAbs * b.natAbs) = a.natAbs * a.natAbs := by
      have := congrArg Int.natAbs hsq
      rw [Int.natAbs_mul, Int.natAbs_mul, Int.natAbs_mul] at this
      exact this
    have hv := congrArg (vp p) hN
    rw [vp_mul hP (by omega) (Nat.mul_pos hB hB), vp_mul hP hB hB, vp_mul hP hA hA,
      vp_eq (e := 1) (r := 1) hP.1 (by rw [Nat.pow_one, Nat.mul_one]) (fun h => by
        have := Nat.le_of_dvd (by decide) h; omega)] at hv
    omega
  · -- `-p b² = a² ≥ 0` is impossible
    have : (0 : Int) ≤ a * a := by
      rcases Int.le_total 0 a with h | h
      · exact Int.mul_nonneg h h
      · exact Int.mul_nonneg_of_nonpos_of_nonpos h h
    have : 0 < (p : Int) * (b * b) := Int.mul_pos (by omega) hbb
    rw [Int.neg_one_mul, Int.neg_mul] at hsq
    omega

end Quadratic

end Foundations.Langlands
