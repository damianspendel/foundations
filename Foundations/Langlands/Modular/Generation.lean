import Foundations.Langlands.Modular.SL2

/-!
# S and T generate SL₂(ℤ)

The two transformations `S : τ ↦ −1/τ` and `T : τ ↦ τ + 1` generate the modular group. In
the language of quadratic forms this is Gauss's reduction; in matrices it is nothing but the
**Euclidean algorithm** applied to the first column `(a, c)`. Indeed, left multiplication by
`Tⁿ` replaces the top row by `top + n · bottom`, and left multiplication by `S` swaps the
rows up to sign. Dividing `a = qc + r` with `0 ≤ r < |c|` and multiplying by `S T⁻q` turns a
matrix with bottom-left entry `c` into one with bottom-left entry `r`. Since `|c|` strictly
decreases, after finitely many steps `c = 0`; then `ad = 1`, so the matrix is `±Tᵇ`, and
`−I = S²`.

We formalise "generated by" as an inductive predicate `Gen` (the smallest set containing
`S`, `T`, `1` and closed under products and inverses), package it as a `Subgroup`
(`genST`), show it is contained in every subgroup containing `S` and `T` (`genST_le`), and
prove `Gen g` for every `g` (`generation`). This is the "easier" Euclidean route; the
alternative derivation from the fundamental domain is not given.

Klein used generation by `S` and `T` to read off the shape of the modular figure, and it is
what makes the definition of a modular form checkable: a function satisfying the
transformation law for `S` and for `T` satisfies it for all of SL₂(ℤ) (file `Forms`).
-/

namespace Foundations.Langlands.Modular

open Foundations.Algebra Foundations.Algebra.Group

namespace SL2Z

/-- **The subgroup generated by S and T**, as an inductive predicate: the smallest set of
matrices containing `S`, `T` and `I` and closed under products and inverses. -/
inductive Gen : SL2Z → Prop
  /-- `S` is in it. -/
  | S : Gen S
  /-- `T` is in it. -/
  | T : Gen T
  /-- `I` is in it. -/
  | one : Gen 1
  /-- Closed under products. -/
  | mul {g h : SL2Z} : Gen g → Gen h → Gen (g * h)
  /-- Closed under inverses. -/
  | inv {g : SL2Z} : Gen g → Gen g⁻¹

/-- `⟨S, T⟩` as a `Subgroup` of SL₂(ℤ). -/
def genST : Subgroup SL2Z where
  carrier := Gen
  one_mem := Gen.one
  mul_mem := Gen.mul
  inv_mem := Gen.inv

/-- `⟨S, T⟩` is the *smallest* subgroup containing `S` and `T`: it lies in every subgroup
`H` with `S, T ∈ H`. -/
theorem genST_le (H : Subgroup SL2Z) (hS : S ∈ H) (hT : T ∈ H) {g : SL2Z} (hg : Gen g) :
    g ∈ H := by
  induction hg with
  | S => exact hS
  | T => exact hT
  | one => exact H.one_mem
  | mul _ _ ih1 ih2 => exact H.mul_mem ih1 ih2
  | inv _ ih => exact H.inv_mem ih

/-- `−I = S²` lies in `⟨S, T⟩`. -/
theorem gen_negOne : Gen negOne := by rw [← S_mul_S]; exact Gen.mul Gen.S Gen.S

/-- Every translation `Tₙ = (1 n; 0 1)` lies in `⟨S, T⟩` (it is `Tⁿ`). -/
theorem gen_Tn (n : Int) : Gen (Tn n) := by
  have hpos : ∀ k : Nat, Gen (Tn k) ∧ Gen (Tn (-(k : Int))) := by
    intro k
    induction k with
    | zero => exact ⟨Gen.one, Gen.one⟩
    | succ k ih =>
      constructor
      · have : Tn ((k + 1 : Nat) : Int) = Tn k * T := by
          rw [← Tn_one, Tn_mul]; congr 1
        rw [this]; exact Gen.mul ih.1 Gen.T
      · have : Tn (-((k + 1 : Nat) : Int)) = Tn (-(k : Int)) * T⁻¹ := by
          rw [T_inv, Tn_mul]; congr 1; omega
        rw [this]; exact Gen.mul ih.2 (Gen.inv Gen.T)
  rcases Int.eq_nat_or_neg n with ⟨k, rfl | rfl⟩
  · exact (hpos k).1
  · exact (hpos k).2

/-- Upper triangular matrices lie in `⟨S, T⟩`: if `c = 0` then `g = ±T^b`. -/
theorem gen_of_c_eq_zero {g : SL2Z} (hc : g.c = 0) : Gen g := by
  have hdet := g.det
  rw [hc, Int.mul_zero, Int.sub_zero] at hdet
  have hunit : g.a = 1 ∨ g.a = -1 := by
    have h2 : g.a.natAbs * g.d.natAbs = 1 := by rw [← Int.natAbs_mul, hdet]; rfl
    have : g.a.natAbs = 1 := Nat.eq_one_of_mul_eq_one_right h2
    omega
  rcases hunit with ha | ha
  · have hd : g.d = 1 := by rw [ha] at hdet; omega
    have : g = Tn g.b := ext ha rfl hc hd
    rw [this]; exact gen_Tn _
  · have hd : g.d = -1 := by rw [ha] at hdet; omega
    have : g = negOne * Tn (-g.b) := by
      apply ext <;> simp [negOne, Tn, ha, hc, hd]
    rw [this]; exact Gen.mul gen_negOne (gen_Tn _)

/-- **One Euclidean step.** If `c ≠ 0`, write `a = qc + r` with `0 ≤ r < |c|`; then
`S T₋q g` has bottom-left entry `r`. -/
theorem euclid_step (g : SL2Z) :
    (S * (Tn (-(g.a / g.c)) * g)).c = g.a % g.c := by
  simp only [mul_c, S, Tn, mul_a]
  have := Int.mul_ediv_add_emod g.a g.c
  grind

/-- **Generation.** SL₂(ℤ) is generated by `S` and `T`: every `g` lies in `⟨S, T⟩`. The proof
is the Euclidean algorithm on the first column, by strong induction on `|c|`. -/
theorem generation (g : SL2Z) : Gen g := by
  have key : ∀ n : Nat, ∀ g : SL2Z, g.c.natAbs = n → Gen g := by
    intro n
    induction n using Nat.strongRecOn with
    | _ n ih =>
      intro g hn
      by_cases hc : g.c = 0
      · exact gen_of_c_eq_zero hc
      · let g' := S * (Tn (-(g.a / g.c)) * g)
        have hc' : g'.c = g.a % g.c := euclid_step g
        have h0 := Int.emod_nonneg g.a hc
        have h1 := Int.emod_lt g.a hc
        have hg' : Gen g' := ih g'.c.natAbs (by rw [hc']; omega) g' rfl
        have : g = (S * Tn (-(g.a / g.c)))⁻¹ * g' := by
          show g = (S * Tn (-(g.a / g.c)))⁻¹ * (S * (Tn (-(g.a / g.c)) * g))
          rw [← mul_assoc S, inv_mul_cancel_left]
        rw [this]
        exact Gen.mul (Gen.inv (Gen.mul Gen.S (gen_Tn _))) hg'
  exact key _ g rfl

/-- **Generation, subgroup form.** `⟨S, T⟩` is the whole group. -/
theorem genST_eq_top : genST = Subgroup.top := Subgroup.ext fun _ => ⟨fun _ => trivial,
  fun _ => generation _⟩

/-- **Induction principle for SL₂(ℤ).** A property of matrices that holds for `I`, and is
preserved by left multiplication with `S`, `S⁻¹`, `T` and `T⁻¹`, holds for every matrix. -/
theorem induction_on {P : SL2Z → Prop} (h1 : P 1) (hS : ∀ g, P g → P (S * g))
    (hS' : ∀ g, P g → P (S⁻¹ * g)) (hT : ∀ g, P g → P (T * g))
    (hT' : ∀ g, P g → P (T⁻¹ * g)) (g : SL2Z) : P g := by
  -- Show `∀ h, P h → P (x * h)` for every `x ∈ ⟨S, T⟩`, then apply it to `h = 1`.
  have hmul : ∀ x, Gen x → (∀ h, P h → P (x * h)) ∧ (∀ h, P h → P (x⁻¹ * h)) := by
    intro x hx
    induction hx with
    | S => exact ⟨hS, hS'⟩
    | T => exact ⟨hT, hT'⟩
    | one => exact ⟨fun h hh => by rw [one_mul]; exact hh,
        fun h hh => by rw [inv_one, one_mul]; exact hh⟩
    | mul _ _ ih1 ih2 =>
      refine ⟨fun h hh => ?_, fun h hh => ?_⟩
      · rw [mul_assoc]; exact ih1.1 _ (ih2.1 _ hh)
      · rw [mul_inv_rev, mul_assoc]; exact ih2.2 _ (ih1.2 _ hh)
    | inv _ ih =>
      refine ⟨ih.2, fun h hh => ?_⟩
      rw [inv_inv]; exact ih.1 _ hh
  have := (hmul g (generation g)).1 1 h1
  rwa [mul_one] at this

end SL2Z

end Foundations.Langlands.Modular
