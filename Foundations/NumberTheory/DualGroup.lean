import Foundations.NumberTheory.Characters

/-!
# The dual group: enough characters, and orthogonality

This file carries out the construction announced in `Characters`. For a finite commutative group
`G` we build, by extending characters from a subgroup `H` to the subgroup `⟨H, g⟩` generated by
`H` and one more element, a list of characters of `G` satisfying

  `Σ_χ χ(x) = (number of characters) · [x = 1]`.

From this one identity everything else follows: the characters **separate points** (for `x ≠ 1`
some `χ` has `χ(x) ≠ 1`), the list contains **every** character of `G` (a character missing from
it would be orthogonal to all of them, which the identity forbids), so the characters form a
finite type `Ĝ`, with `|Ĝ| = |G|` and the two **orthogonality relations**

  `Σ_{x ∈ G} χ(x) = |G| · [χ = 1]`,   `Σ_{χ ∈ Ĝ} χ(a) · conj χ(b) = |G| · [a = b]`.

Characters take values on the unit circle (`χ(x)^{|G|} = 1`), so `conj χ(x) = χ(x⁻¹)`.
-/

namespace Foundations.NumberTheory

open Foundations.Algebra Foundations.Algebra.FiniteType Foundations.Algebra.Group
open Foundations.Numbers Lean.Grind

universe u

attribute [local instance] Classical.propDecidable

variable {G : Type u} [CommGroup G]

/-! ## Characters on a subgroup -/

/-- `χ : G → ℂ` is a **character on the subgroup `H`**: `χ(1) = 1` and `χ(ab) = χ(a)χ(b)` for
`a, b ∈ H` (values off `H` are irrelevant). -/
structure IsCharOn (H : Subgroup G) (χ : G → C) : Prop where
  /-- `χ(1) = 1`. -/
  map_one : χ 1 = 1
  /-- `χ` is multiplicative on `H`. -/
  map_mul : ∀ a b, a ∈ H → b ∈ H → χ (a * b) = χ a * χ b

/-- A character on `H` respects powers of elements of `H`. -/
theorem IsCharOn.map_pow {H : Subgroup G} {χ : G → C} (hχ : IsCharOn H χ) {a : G} (ha : a ∈ H) :
    ∀ n : Nat, χ (a ^ n) = χ a ^ n
  | 0 => hχ.map_one
  | n + 1 => by
    rw [pow_succ, hχ.map_mul _ _ (H.pow_mem ha n) ha, hχ.map_pow ha n]; rfl

/-- An **orthogonal family of characters on `H`**: a non-empty list of characters on `H` with
`Σ_χ χ(x) = (length) · [x = 1]` for every `x ∈ H`. -/
def Ortho (H : Subgroup G) (L : List (G → C)) : Prop :=
  L ≠ [] ∧ (∀ χ ∈ L, IsCharOn H χ) ∧
    ∀ x ∈ H, lsum L (fun χ => χ x) = if x = 1 then (L.length : C) else 0

/-! ## Adjoining one element to a subgroup -/

/-- Rearranging a product of four factors in a commutative group. -/
theorem mul_mul_mul_comm' (a b c d : G) : a * b * (c * d) = a * c * (b * d) := by
  rw [mul_assoc, ← mul_assoc b, CommGroup.mul_comm b c, mul_assoc c, ← mul_assoc]

variable [FiniteType G]

/-- The subgroup `⟨H, g⟩ = {h gᵏ : h ∈ H, k ∈ ℕ}` generated by `H` and `g`. -/
noncomputable def join (H : Subgroup G) (g : G) : Subgroup G where
  carrier x := ∃ h, h ∈ H ∧ ∃ k : Nat, x = h * g ^ k
  one_mem := ⟨1, H.one_mem, 0, by rw [pow_zero, mul_one]⟩
  mul_mem := by
    rintro a b ⟨h, hh, k, rfl⟩ ⟨h', hh', k', rfl⟩
    exact ⟨h * h', H.mul_mem hh hh', k + k', by rw [pow_add, mul_mul_mul_comm']⟩
  inv_mem := by
    rintro a ⟨h, hh, k, rfl⟩
    refine ⟨h⁻¹, H.inv_mem hh, k * (orderOf g - 1), ?_⟩
    apply inv_eq_of_mul_eq_one
    rw [mul_mul_mul_comm', mul_inv_cancel, one_mul, ← pow_add]
    have ho := orderOf_pos g
    obtain ⟨o, ho'⟩ : ∃ o, orderOf g = o + 1 := ⟨orderOf g - 1, by omega⟩
    rw [show k + k * (orderOf g - 1) = orderOf g * k by
      rw [ho', Nat.add_sub_cancel, Nat.succ_mul, Nat.mul_comm]; omega]
    rw [pow_mul, pow_orderOf, one_pow]

/-- `H ⊆ ⟨H, g⟩`. -/
theorem mem_join_of_mem {H : Subgroup G} {g h : G} (hh : h ∈ H) : h ∈ join H g :=
  ⟨h, hh, 0, by rw [pow_zero, mul_one]⟩

/-- `g ∈ ⟨H, g⟩`. -/
theorem mem_join_self (H : Subgroup G) (g : G) : g ∈ join H g :=
  ⟨1, H.one_mem, 1, by rw [pow_one, one_mul]⟩

/-- There is a least `m ≥ 1` with `gᵐ ∈ H`, and then `gᵏ ∈ H ⟺ m ∣ k`. -/
theorem exists_min_pow (H : Subgroup G) (g : G) :
    ∃ m, 0 < m ∧ ∀ k, g ^ k ∈ H ↔ m ∣ k := by
  obtain ⟨m, ⟨hm0, hmH⟩, hmin⟩ := exists_least (fun n => 0 < n ∧ g ^ n ∈ H)
    ⟨orderOf g, orderOf_pos g, by rw [pow_orderOf]; exact H.one_mem⟩
  refine ⟨m, hm0, fun k => ⟨fun hk => ?_, fun ⟨s, hs⟩ => ?_⟩⟩
  · have e : g ^ k = (g ^ m) ^ (k / m) * g ^ (k % m) := by
      rw [← pow_mul, ← pow_add, Nat.div_add_mod]
    rw [e] at hk
    have hr := (H.mul_mem_left_iff (H.pow_mem hmH _)).1 hk
    apply Nat.dvd_of_mod_eq_zero
    apply Classical.byContradiction
    intro hne
    exact hmin _ (Nat.mod_lt _ hm0) ⟨by omega, hr⟩
  · rw [hs, pow_mul]; exact H.pow_mem hmH s

/-! ## Extending a character -/

/-- The extension of `χ` from `H` to `⟨H, g⟩` sending `g` to `u`: `h gᵏ ↦ χ(h) uᵏ`. (The
representative `(h, k)` is chosen; `extend_eq` shows the choice does not matter when `uᵐ = χ(gᵐ)`.)
-/
noncomputable def extend (H : Subgroup G) (g : G) (χ : G → C) (u : C) (x : G) : C :=
  if hx : x ∈ join H g then
    χ (Classical.choose hx) * u ^ (Classical.choose (Classical.choose_spec hx).2)
  else 0

omit [FiniteType G] in
/-- **Well-definedness** of the extension: if `h gᵏ = h' g^{k'}` with `h, h' ∈ H` and
`uᵐ = χ(gᵐ)`, then `χ(h) uᵏ = χ(h') u^{k'}`. -/
theorem extend_wd_le {H : Subgroup G} {g : G} {m : Nat} (hm : ∀ k, g ^ k ∈ H ↔ m ∣ k)
    {χ : G → C} (hχ : IsCharOn H χ) {u : C} (hu : u ^ m = χ (g ^ m))
    {h h' : G} {k k' : Nat} (hh : h ∈ H) (hh' : h' ∈ H) (hkk : k' ≤ k)
    (e : h * g ^ k = h' * g ^ k') : χ h * u ^ k = χ h' * u ^ k' := by
  obtain ⟨t, rfl⟩ : ∃ t, k = k' + t := ⟨k - k', by omega⟩
  rw [pow_add, ← mul_assoc, CommGroup.mul_comm (h * g ^ k'), ← mul_assoc,
    CommGroup.mul_comm _ h] at e
  have e2 : h * g ^ t = h' := mul_right_cancel e
  have hgt : g ^ t ∈ H := by
    have := H.mul_mem (H.inv_mem hh) hh'
    rw [← e2, inv_mul_cancel_left] at this; exact this
  obtain ⟨s, rfl⟩ := (hm t).1 hgt
  have hgm : g ^ m ∈ H := (hm m).2 (Nat.dvd_refl m)
  have hut : u ^ (m * s) = χ (g ^ (m * s)) := by
    rw [cpow_mul, hu, pow_mul, hχ.map_pow hgm]
  rw [cpow_add, ← e2, hχ.map_mul _ _ hh hgt, hut]
  grind

omit [FiniteType G] in
/-- Well-definedness, without the order assumption. -/
theorem extend_wd {H : Subgroup G} {g : G} {m : Nat} (hm : ∀ k, g ^ k ∈ H ↔ m ∣ k)
    {χ : G → C} (hχ : IsCharOn H χ) {u : C} (hu : u ^ m = χ (g ^ m))
    {h h' : G} {k k' : Nat} (hh : h ∈ H) (hh' : h' ∈ H)
    (e : h * g ^ k = h' * g ^ k') : χ h * u ^ k = χ h' * u ^ k' := by
  rcases Nat.le_total k' k with hkk | hkk
  · exact extend_wd_le hm hχ hu hh hh' hkk e
  · exact (extend_wd_le hm hχ hu hh' hh hkk e.symm).symm

/-- The extension takes the value `χ(h) uᵏ` at `h gᵏ`. -/
theorem extend_eq {H : Subgroup G} {g : G} {m : Nat} (hm : ∀ k, g ^ k ∈ H ↔ m ∣ k)
    {χ : G → C} (hχ : IsCharOn H χ) {u : C} (hu : u ^ m = χ (g ^ m))
    {h : G} (hh : h ∈ H) (k : Nat) : extend H g χ u (h * g ^ k) = χ h * u ^ k := by
  have hx : h * g ^ k ∈ join H g := ⟨h, hh, k, rfl⟩
  unfold extend
  rw [dite_eq_left hx]
  have s1 := Classical.choose_spec hx
  have s2 := Classical.choose_spec s1.2
  exact extend_wd hm hχ hu s1.1 hh s2.symm

/-- The extension is a character on `⟨H, g⟩`. -/
theorem extend_isCharOn {H : Subgroup G} {g : G} {m : Nat} (hm : ∀ k, g ^ k ∈ H ↔ m ∣ k)
    {χ : G → C} (hχ : IsCharOn H χ) {u : C} (hu : u ^ m = χ (g ^ m)) :
    IsCharOn (join H g) (extend H g χ u) where
  map_one := by
    have := extend_eq hm hχ hu H.one_mem 0
    rw [pow_zero, mul_one, hχ.map_one] at this
    rw [this]; show (1 : C) * 1 = 1; grind
  map_mul := by
    rintro a b ⟨h, hh, k, rfl⟩ ⟨h', hh', k', rfl⟩
    rw [mul_mul_mul_comm', ← pow_add, extend_eq hm hχ hu (H.mul_mem hh hh'),
      extend_eq hm hχ hu hh, extend_eq hm hχ hu hh', hχ.map_mul _ _ hh hh', cpow_add]
    grind

/-- **The extension step.** An orthogonal family on `H` yields one on `⟨H, g⟩`: each `χ` is
extended in the `m` ways `g ↦ w·ζₘʲ` (`j < m`), where `wᵐ = χ(gᵐ)`. -/
theorem ortho_join {H : Subgroup G} {L : List (G → C)} (hL : Ortho H L) (g : G) :
    ∃ L', Ortho (join H g) L' := by
  obtain ⟨hne, hchar, hsum⟩ := hL
  obtain ⟨m, hm0, hm⟩ := exists_min_pow H g
  have hgm : g ^ m ∈ H := (hm m).2 (Nat.dvd_refl m)
  let w : (G → C) → C := fun χ => Classical.choose (C.exists_pow_eq (χ (g ^ m)) hm0)
  have hw : ∀ χ, w χ ^ m = χ (g ^ m) := fun χ => Classical.choose_spec (C.exists_pow_eq _ hm0)
  have hu : ∀ χ (j : Nat), (w χ * zeta m ^ j) ^ m = χ (g ^ m) := by
    intro χ j
    rw [C.mul_pow, hw, ← cpow_mul, Nat.mul_comm, cpow_mul, zeta_pow_self hm0, cone_pow]; grind
  let E : (G → C) → List (G → C) := fun χ =>
    (List.range m).map (fun j => extend H g χ (w χ * zeta m ^ j))
  refine ⟨L.flatMap E, ?_, ?_, ?_⟩
  · -- non-empty
    obtain ⟨χ, hχ⟩ : ∃ χ, χ ∈ L := by
      cases L with
      | nil => exact absurd rfl hne
      | cons a l => exact ⟨a, List.mem_cons_self⟩
    intro h
    have : extend H g χ (w χ * zeta m ^ 0) ∈ L.flatMap E :=
      List.mem_flatMap.2 ⟨χ, hχ, List.mem_map.2 ⟨0, List.mem_range.2 hm0, rfl⟩⟩
    rw [h] at this; cases this
  · intro ψ hψ
    obtain ⟨χ, hχ, hψ⟩ := List.mem_flatMap.1 hψ
    obtain ⟨j, -, rfl⟩ := List.mem_map.1 hψ
    exact extend_isCharOn hm (hchar χ hχ) (hu χ j)
  · rintro x ⟨h, hh, k, rfl⟩
    have hlen : ((L.flatMap E).length : C) = (L.length : C) * (m : C) := by
      have e1 := lsum_const (L.flatMap E) (1 : C)
      rw [lsum_flatMap] at e1
      have e2 : ∀ χ ∈ L, lsum (E χ) (fun _ => (1 : C)) = (m : C) := by
        intro χ _
        rw [lsum_const, List.length_map, List.length_range]; grind
      rw [lsum_congr e2, lsum_const] at e1
      grind
    rw [lsum_flatMap]
    have e3 : ∀ χ ∈ L, lsum (E χ) (fun ψ => ψ (h * g ^ k)) =
        χ h * w χ ^ k * (if m ∣ k then (m : C) else 0) := by
      intro χ hχ
      rw [lsum_map, ← lsum_zeta_pow hm0 k, ← lsum_mul_left]
      apply lsum_congr
      intro j _
      rw [extend_eq hm (hchar χ hχ) (hu χ j) hh, C.mul_pow]; grind
    rw [lsum_congr e3]
    by_cases hd : m ∣ k
    · obtain ⟨s, rfl⟩ := hd
      have e4 : ∀ χ ∈ L, χ h * w χ ^ (m * s) * (if m ∣ m * s then (m : C) else 0) =
          (m : C) * χ (h * g ^ (m * s)) := by
        intro χ hχ
        rw [ite_eq_left (Nat.dvd_mul_right m s), cpow_mul, hw, pow_mul,
          ← (hchar χ hχ).map_pow hgm, ← (hchar χ hχ).map_mul _ _ hh (H.pow_mem hgm s)]
        grind
      rw [lsum_congr e4, lsum_mul_left, hsum _ (H.mul_mem hh (by rw [pow_mul]; exact H.pow_mem hgm s)),
        hlen]
      split <;> grind
    · have e4 : ∀ χ ∈ L, χ h * w χ ^ k * (if m ∣ k then (m : C) else 0) = 0 := by
        intro χ _; rw [ite_eq_right hd]; grind
      rw [lsum_congr e4, lsum_zero]
      have hx : h * g ^ k ≠ 1 := by
        intro e
        apply hd; apply (hm k).1
        have : g ^ k = h⁻¹ := by
          apply mul_left_cancel (a := h); rw [e, mul_inv_cancel]
        rw [this]; exact H.inv_mem hh
      rw [ite_eq_right hx]

/-! ## From the trivial subgroup to the whole group -/

omit [FiniteType G] in
/-- The family `[1]` is orthogonal on the trivial subgroup. -/
theorem ortho_bot : Ortho (Subgroup.bot : Subgroup G) [fun _ => (1 : C)] := by
  refine ⟨List.cons_ne_nil _ _, ?_, ?_⟩
  · intro χ hχ
    rw [List.mem_singleton] at hχ; subst hχ
    exact ⟨rfl, fun _ _ _ _ => by grind⟩
  · intro x hx
    have hx' : x = 1 := hx
    rw [ite_eq_left hx', lsum_cons, lsum_nil, List.length_singleton]; grind

omit [FiniteType G] in
/-- An orthogonal family on a subgroup containing everything is orthogonal on `G`. -/
theorem ortho_top_of_all {H : Subgroup G} {L : List (G → C)} (hL : Ortho H L)
    (hall : ∀ x, x ∈ H) : Ortho (Subgroup.top : Subgroup G) L :=
  ⟨hL.1, fun χ hχ => ⟨(hL.2.1 χ hχ).map_one,
    fun a b _ _ => (hL.2.1 χ hχ).map_mul a b (hall a) (hall b)⟩, fun x _ => hL.2.2 x (hall x)⟩

/-- Iterating the extension step: from any orthogonal family on any subgroup we reach an
orthogonal family on all of `G` (by induction on the number of elements outside the subgroup). -/
theorem ortho_top_aux (n : Nat) : ∀ (H : Subgroup G) (L : List (G → C)),
    count (fun x => x ∉ H) ≤ n → Ortho H L → ∃ L', Ortho (Subgroup.top : Subgroup G) L' := by
  induction n with
  | zero =>
    intro H L hn hL
    refine ⟨L, ortho_top_of_all hL fun x => ?_⟩
    apply Classical.byContradiction; intro hx
    have := (count_pos (P := fun x => x ∉ H)).2 ⟨x, hx⟩; omega
  | succ n ih =>
    intro H L hn hL
    by_cases hall : ∀ x, x ∈ H
    · exact ⟨L, ortho_top_of_all hL hall⟩
    · obtain ⟨g, hg⟩ : ∃ g, g ∉ H := Classical.byContradiction fun h =>
        hall fun x => Classical.byContradiction fun hx => h ⟨x, hx⟩
      obtain ⟨L', hL'⟩ := ortho_join hL g
      apply ih (join H g) L' _ hL'
      have hsplit := count_split (fun x => x ∉ H) (fun x => x ∈ join H g)
      have h1 : count (fun x => x ∉ H ∧ ¬ x ∈ join H g) = count (fun x => x ∉ join H g) :=
        count_congr fun x => ⟨fun h => h.2, fun h => ⟨fun hx => h (mem_join_of_mem hx), h⟩⟩
      have h2 : 0 < count (fun x => x ∉ H ∧ x ∈ join H g) :=
        count_pos.2 ⟨g, hg, mem_join_self H g⟩
      omega

/-! ## Characters of `G` -/

/-- A **character** of `G`: a homomorphism `χ : G → ℂ`, i.e. `χ(1) = 1` and `χ(ab) = χ(a)χ(b)`. -/
structure IsChar (χ : G → C) : Prop where
  /-- `χ(1) = 1`. -/
  map_one : χ 1 = 1
  /-- `χ(ab) = χ(a)χ(b)`. -/
  map_mul : ∀ a b, χ (a * b) = χ a * χ b

/-- **Existence of an orthogonal family of characters** of `G`: a non-empty list of characters
with `Σ_χ χ(x) = (length) · [x = 1]` for all `x`. -/
theorem exists_ortho_family : ∃ L : List (G → C), L ≠ [] ∧ (∀ χ ∈ L, IsChar χ) ∧
    ∀ x, lsum L (fun χ => χ x) = if x = 1 then (L.length : C) else 0 := by
  obtain ⟨L, hne, hch, hs⟩ := ortho_top_aux (card G) Subgroup.bot [fun _ => (1 : C)]
    (count_le_card _) ortho_bot
  exact ⟨L, hne, fun χ hχ => ⟨(hch χ hχ).map_one, fun a b => (hch χ hχ).map_mul a b trivial trivial⟩,
    fun x => hs x trivial⟩

/-- A positive natural number is non-zero in `ℂ`. -/
theorem natCast_ne_zero_C {n : Nat} (hn : 0 < n) : (n : C) ≠ 0 := by
  intro h
  have : ((n : C)).re = (n : R) := rfl
  rw [h] at this
  have := OrderedRing.pos_natCast_of_pos (R := R) n hn
  rw [← ‹(0 : C).re = (n : R)›] at this
  exact absurd this (by show ¬ ((0 : R) < 0); grind)

/-- If `c · S = S` with `c ≠ 1`, then `S = 0`. -/
theorem eq_zero_of_mul_eq_self {c S : C} (h : c * S = S) (hc : c ≠ 1) : S = 0 := by
  have hc' : c - 1 ≠ 0 := fun e => hc (by grind)
  calc S = (c - 1)⁻¹ * ((c - 1) * S) := by
          rw [← Semiring.mul_assoc, Field.inv_mul_cancel hc', Semiring.one_mul]
    _ = 0 := by rw [show (c - 1) * S = 0 by grind]; grind

namespace IsChar

variable {χ : G → C}

omit [FiniteType G] in
/-- Characters respect powers. -/
theorem map_pow (hχ : IsChar χ) (a : G) : ∀ n : Nat, χ (a ^ n) = χ a ^ n
  | 0 => hχ.map_one
  | n + 1 => by rw [pow_succ, hχ.map_mul, hχ.map_pow a n]; rfl

omit [FiniteType G] in
/-- `χ(a) χ(a⁻¹) = 1`. -/
theorem mul_inv (hχ : IsChar χ) (a : G) : χ a * χ a⁻¹ = 1 := by
  rw [← hχ.map_mul, mul_inv_cancel, hχ.map_one]

omit [FiniteType G] in
/-- Character values are non-zero. -/
theorem ne_zero (hχ : IsChar χ) (a : G) : χ a ≠ 0 := by
  intro h; have := hχ.mul_inv a; rw [h] at this; exact absurd this (by
    show ¬ ((0 : C) * χ a⁻¹ = 1); rw [Semiring.zero_mul]; exact C.zero_ne_one)

/-- **First orthogonality relation** for a non-trivial character: if `χ(y) ≠ 1` for some `y`,
then `Σ_{x ∈ G} χ(x) = 0`. (Multiplying by `χ(y)` permutes the terms.) -/
theorem sum_eq_zero (hχ : IsChar χ) {y : G} (hy : χ y ≠ 1) : sumOver χ = 0 := by
  apply eq_zero_of_mul_eq_self _ hy
  have e := sumOver_comp_injective (fun x => y * x) (fun a b h => mul_left_cancel h) χ
  calc χ y * sumOver χ = sumOver (fun x => χ (y * x)) := by
        unfold sumOver; rw [← lsum_mul_left]
        exact lsum_congr fun x _ => (hχ.map_mul y x).symm
    _ = sumOver χ := e

end IsChar

/-- For `0 ≤ r`, `n ≥ 1`: `rⁿ = 1` forces `r = 1`. -/
theorem eq_one_of_pow_eq_one {r : R} (hr : 0 ≤ r) {n : Nat} (hn : 1 ≤ n) (h : r ^ n = 1) : r = 1 := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  have low : r ≤ 1 → ∀ j : Nat, r ^ (j + 1) ≤ r := by
    intro h1 j
    induction j with
    | zero => show r ^ 0 * r ≤ r; rw [Semiring.pow_zero]; grind
    | succ j ih =>
      show r ^ (j + 1) * r ≤ r
      have := OrderedRing.mul_le_mul_of_nonneg_right ih hr
      have := OrderedRing.mul_le_mul_of_nonneg_left h1 hr
      grind
  have high : 1 ≤ r → ∀ j : Nat, r ≤ r ^ (j + 1) := by
    intro h1 j
    induction j with
    | zero => show r ≤ r ^ 0 * r; rw [Semiring.pow_zero]; grind
    | succ j ih =>
      show r ≤ r ^ (j + 1) * r
      have := OrderedRing.mul_le_mul_of_nonneg_right ih hr
      have := OrderedRing.mul_le_mul_of_nonneg_left h1 hr
      grind
  rcases (by grind : r ≤ 1 ∨ 1 ≤ r) with h1 | h1
  · have := low h1 k; have := high (by grind) k
    grind
  · have := high h1 k; grind

namespace IsChar

variable {χ : G → C}

/-- **Characters take values on the unit circle**: `|χ(a)| = 1`, since `χ(a)^{|G|} = χ(1) = 1`. -/
theorem cabs_eq_one (hχ : IsChar χ) (a : G) : C.cabs (χ a) = 1 := by
  have h1 : χ a ^ card G = 1 := by rw [← hχ.map_pow, pow_card_eq_one, hχ.map_one]
  have h2 : C.cabs (χ a) ^ card G = 1 := by
    rw [← C.cabs_pow, h1]; exact C.cabs_ofReal (x := 1) (by grind)
  have hpos : 1 ≤ card G := by
    have := count_le_card (fun x : G => x = 1)
    rw [count_eq_self] at this; exact this
  exact eq_one_of_pow_eq_one (C.cabs_nonneg _) hpos h2

/-- `conj χ(a) = χ(a⁻¹) = χ(a)⁻¹`. -/
theorem conj_eq (hχ : IsChar χ) (a : G) : C.conj (χ a) = χ a⁻¹ := by
  have hn : C.normSq (χ a) = 1 := by rw [← C.cabs_mul_self, hχ.cabs_eq_one]; grind
  have h1 : χ a * C.conj (χ a) = 1 := by rw [C.mul_conj, hn]; rfl
  calc C.conj (χ a) = (χ a⁻¹ * χ a) * C.conj (χ a) := by
          rw [C.mul_comm (χ a⁻¹), hχ.mul_inv]; grind
    _ = χ a⁻¹ := by rw [Semiring.mul_assoc, h1]; grind

omit [FiniteType G] in
/-- The complex conjugate of a character is a character. -/
theorem conj (hχ : IsChar χ) : IsChar (fun a => C.conj (χ a)) :=
  ⟨by show C.conj (χ 1) = 1; rw [hχ.map_one]; rfl,
   fun a b => by show C.conj (χ (a * b)) = C.conj (χ a) * C.conj (χ b); rw [hχ.map_mul, C.conj_mul]⟩

omit [FiniteType G] in
/-- The product of two characters is a character. -/
theorem mul {ψ : G → C} (hχ : IsChar χ) (hψ : IsChar ψ) : IsChar (fun a => χ a * ψ a) :=
  ⟨by show χ 1 * ψ 1 = 1; rw [hχ.map_one, hψ.map_one]; grind,
   fun a b => by show χ (a * b) * ψ (a * b) = χ a * ψ a * (χ b * ψ b)
                 rw [hχ.map_mul, hψ.map_mul]; grind⟩

end IsChar

/-- **Every character occurs in an orthogonal family.** If `L` is a non-empty list of characters
with `Σ_{ψ ∈ L} ψ(x) = |L| · [x = 1]`, then every character `χ` belongs to `L`: otherwise each
`ψ · χ̄` would be a non-trivial character, so `Σ_x Σ_ψ ψ(x) χ(x⁻¹) = 0`, while summing in the
other order gives `|L|`. -/
theorem mem_of_ortho {L : List (G → C)} (hne : L ≠ []) (hch : ∀ ψ ∈ L, IsChar ψ)
    (hs : ∀ x, lsum L (fun ψ => ψ x) = if x = 1 then (L.length : C) else 0)
    {χ : G → C} (hχ : IsChar χ) : χ ∈ L := by
  apply Classical.byContradiction
  intro hnot
  have hlen : 0 < L.length := by
    cases L with
    | nil => exact absurd rfl hne
    | cons a l => simp
  -- Sum in one order: each inner sum vanishes.
  have hA : lsum L (fun ψ => sumOver (fun x => ψ x * χ x⁻¹)) = 0 := by
    rw [lsum_congr (g := fun _ => (0 : C)) ?_, lsum_zero]
    intro ψ hψ
    have hne' : ψ ≠ χ := fun e => hnot (e ▸ hψ)
    obtain ⟨y, hy⟩ : ∃ y, ψ y ≠ χ y := Classical.byContradiction fun h =>
      hne' (funext fun y => Classical.byContradiction fun hy => h ⟨y, hy⟩)
    have hθ : IsChar (fun x => ψ x * χ x⁻¹) := by
      have := (hch ψ hψ).mul hχ.conj
      exact ⟨by have := this.map_one; simp only [hχ.conj_eq] at this; exact this,
        fun a b => by have := this.map_mul a b; simp only [hχ.conj_eq] at this; exact this⟩
    apply hθ.sum_eq_zero (y := y)
    intro h1
    apply hy
    calc ψ y = ψ y * (χ y⁻¹ * χ y) := by rw [C.mul_comm (χ y⁻¹), hχ.mul_inv, C.mul_one]
      _ = ψ y * χ y⁻¹ * χ y := (C.mul_assoc _ _ _).symm
      _ = χ y := by rw [h1, C.one_mul]
  -- Sum in the other order: only `x = 1` contributes.
  have hB : lsum L (fun ψ => sumOver (fun x => ψ x * χ x⁻¹)) = (L.length : C) := by
    unfold sumOver
    rw [lsum_comm]
    have e : ∀ x ∈ (FiniteType.elems : List G), lsum L (fun ψ => ψ x * χ x⁻¹) =
        χ x⁻¹ * (if x = 1 then (L.length : C) else 0) := by
      intro x _
      rw [← hs x, ← lsum_mul_left]; exact lsum_congr fun ψ _ => by grind
    rw [lsum_congr e]
    have := sumOver_single (1 : G) (fun x => χ x⁻¹ * (if x = 1 then (L.length : C) else 0))
      (fun x hx => by rw [ite_eq_right hx]; grind)
    unfold sumOver at this; rw [this, ite_eq_left rfl, inv_one, hχ.map_one]; grind
  rw [hA] at hB
  exact natCast_ne_zero_C hlen hB.symm

/-! ## The dual group as a finite type -/

/-- Removing repetitions from a list (keeping the last occurrence). -/
noncomputable def nub {β : Type u} : List β → List β
  | [] => []
  | a :: l => if a ∈ l then nub l else a :: nub l

/-- `nub` keeps exactly the entries of the list. -/
theorem mem_nub {β : Type u} : ∀ (l : List β) (x : β), x ∈ nub l ↔ x ∈ l
  | [] , x => by simp [nub]
  | a :: l, x => by
    unfold nub
    by_cases ha : a ∈ l
    · rw [ite_eq_left ha, mem_nub l x, List.mem_cons]
      constructor
      · exact Or.inr
      · rintro (rfl | h); exact ha; exact h
    · rw [ite_eq_right ha, List.mem_cons, mem_nub l x, List.mem_cons]

/-- `nub` produces a list without repetitions. -/
theorem nodup_nub {β : Type u} : ∀ l : List β, (nub l).Nodup
  | [] => List.nodup_nil
  | a :: l => by
    unfold nub
    by_cases ha : a ∈ l
    · rw [ite_eq_left ha]; exact nodup_nub l
    · rw [ite_eq_right ha, List.nodup_cons, mem_nub]; exact ⟨ha, nodup_nub l⟩

variable (G) in
/-- The **dual group** `Ĝ`: the characters of `G`. -/
def Character : Type u := {χ : G → C // IsChar χ}

/-- The chosen orthogonal family of characters. -/
noncomputable def orthoFamily : List (G → C) := Classical.choose (exists_ortho_family (G := G))

/-- The defining properties of the chosen orthogonal family. -/
theorem orthoFamily_spec : (orthoFamily : List (G → C)) ≠ [] ∧
    (∀ χ ∈ (orthoFamily : List (G → C)), IsChar χ) ∧
    ∀ x : G, lsum orthoFamily (fun χ => χ x) =
      if x = 1 then ((orthoFamily : List (G → C)).length : C) else 0 :=
  Classical.choose_spec exists_ortho_family

/-- **The dual group is finite**: every character lies in the orthogonal family. -/
noncomputable instance Character.instFinite : FiniteType (Character G) where
  elems := nub ((orthoFamily : List (G → C)).attach.map
    (fun p => (⟨p.1, orthoFamily_spec.2.1 p.1 p.2⟩ : Character G)))
  nodup := nodup_nub _
  complete χ := by
    rw [mem_nub]
    have hmem := mem_of_ortho orthoFamily_spec.1 orthoFamily_spec.2.1 orthoFamily_spec.2.2 χ.2
    exact List.mem_map.2 ⟨⟨χ.1, hmem⟩, List.mem_attach _ _, rfl⟩

end Foundations.NumberTheory
