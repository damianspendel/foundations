import Foundations.Algebra.PolyDivision

/-!
# Euclidean domains and principal ideal domains

Euclid's algorithm for the greatest common divisor rests on one property of the integers:
one can always divide with a remainder *smaller* than the divisor. The same is true for
polynomials over a field (previous file). Rings with such a division, measured by some
"size" in the natural numbers, are called **Euclidean domains**.

Dedekind's ideals were invented to restore unique factorisation where it fails; in a
Euclidean domain it never fails, because every ideal is generated by a single element — the
ring is a **principal ideal domain (PID)**. The proof is the abstract form of Euclid's
algorithm: an ideal is generated by any of its non-zero elements of least size, for the
remainder of anything else on division by it would be smaller still.

In a PID the two possible meanings of "prime number" coincide. An **irreducible** element
admits no non-trivial factorisation (the schoolbook definition); a **prime** element `p` has
the property `p ∣ ab ⇒ p ∣ a or p ∣ b` (Euclid's lemma, Elements VII.30). Prime always implies
irreducible in a domain; that irreducible implies prime is precisely what fails in
Kummer's rings of cyclotomic integers, and it is the key to unique factorisation. We prove
it for every PID — in particular for `ℤ` and for `F[x]`.
-/

namespace Foundations.Algebra

open Ring

universe u

section Divisibility

variable {R : Type u} [CommRing R]

/-- **Divisibility** in a commutative ring: `a` divides `b` if `b = a * c` for some `c`. -/
def Divides (a b : R) : Prop := ∃ c, b = a * c

/-- A **unit** is an element with a multiplicative inverse. -/
def IsUnit (a : R) : Prop := ∃ b, a * b = 1

/-- An element is **irreducible** if it is a non-zero non-unit admitting no factorisation
into two non-units. -/
def Irreducible (p : R) : Prop :=
  p ≠ 0 ∧ ¬ IsUnit p ∧ ∀ a b, p = a * b → IsUnit a ∨ IsUnit b

/-- An element is **prime** if it is a non-zero non-unit such that `p ∣ ab` implies `p ∣ a` or
`p ∣ b`. -/
def IsPrimeElt (p : R) : Prop :=
  p ≠ 0 ∧ ¬ IsUnit p ∧ ∀ a b, Divides p (a * b) → Divides p a ∨ Divides p b

/-- An ideal is **principal** if it consists of the multiples of a single element. -/
def Ideal.IsPrincipal (I : Ideal R) : Prop := ∃ g, ∀ x, x ∈ I ↔ Divides g x

/-- **Principal ideal domain.** An integral domain in which every ideal is principal. -/
def IsPID (R : Type u) [CommRing R] : Prop := IsDomain R ∧ ∀ I : Ideal R, I.IsPrincipal

/-- **Euclidean domain.** An integral domain with a size function `R → ℕ` permitting division
with a remainder that is zero or smaller than the divisor. -/
def IsEuclidean (R : Type u) [CommRing R] : Prop :=
  IsDomain R ∧ ∃ size : R → Nat, ∀ a b : R, b ≠ 0 →
    ∃ q r, a = q * b + r ∧ (r = 0 ∨ size r < size b)

/-- Cancellation in a domain: if `a ≠ 0` and `a * x = a * y` then `x = y`. -/
theorem IsDomain.mul_left_cancel (hD : IsDomain R) {a x y : R} (ha : a ≠ 0)
    (h : a * x = a * y) : x = y := by
  have h0 : a * (x + -y) = 0 := by rw [left_distrib, h, mul_neg, add_neg_cancel]
  rcases hD.2 _ _ h0 with h1 | h1
  · exact absurd h1 ha
  · exact eq_of_sub_eq_zero h1

/-- **Prime elements are irreducible** in an integral domain. -/
theorem IsPrimeElt.irreducible (hD : IsDomain R) {p : R} (hp : IsPrimeElt p) : Irreducible p := by
  refine ⟨hp.1, hp.2.1, fun a b hab => ?_⟩
  rcases hp.2.2 a b ⟨1, by rw [Ring.mul_one, hab]⟩ with ⟨c, hc⟩ | ⟨c, hc⟩
  · right
    refine ⟨c, hD.mul_left_cancel hp.1 ?_⟩
    calc p * (b * c) = (p * c) * b := by ac_rfl
      _ = p * 1 := by rw [← hc, ← hab, Ring.mul_one]
  · left
    refine ⟨c, hD.mul_left_cancel hp.1 ?_⟩
    calc p * (a * c) = a * (p * c) := by ac_rfl
      _ = p * 1 := by rw [← hc, ← hab, Ring.mul_one]

end Divisibility

/-! ## Euclidean domains are PIDs -/

/-- **Every Euclidean domain is a principal ideal domain.** An ideal is generated by any of
its non-zero elements of least size. -/
theorem IsEuclidean.isPID {R : Type u} [CommRing R] (hE : IsEuclidean R) : IsPID R := by
  obtain ⟨hD, size, hdiv⟩ := hE
  refine ⟨hD, fun I => ?_⟩
  by_cases hz : ∀ x, x ∈ I → x = 0
  · refine ⟨0, fun x => ⟨fun hx => ⟨0, by rw [hz x hx, mul_zero]⟩, fun ⟨c, hc⟩ => ?_⟩⟩
    rw [hc, zero_mul]; exact I.zero_mem
  · have hex : ∃ n, ∃ x, x ∈ I ∧ x ≠ 0 ∧ size x = n := by
      apply Classical.byContradiction
      intro hno
      exact hz fun x hx => Classical.byContradiction fun hne => hno ⟨_, x, hx, hne, rfl⟩
    obtain ⟨n, ⟨g, hgI, hg0, hgn⟩, hmin⟩ := FiniteType.exists_least _ hex
    refine ⟨g, fun x => ⟨fun hx => ?_, fun ⟨c, hc⟩ => ?_⟩⟩
    · obtain ⟨q, r, hqr, hr⟩ := hdiv x g hg0
      have hrI : r ∈ I := by
        have : r = x + -(q * g) := by rw [hqr, Ring.add_comm (q * g), Ring.add_assoc,
          add_neg_cancel, add_zero]
        rw [this]; exact I.add_mem hx (I.neg_mem (I.mul_mem q hgI))
      rcases hr with hr | hr
      · exact ⟨q, by rw [hqr, hr, add_zero, CommRing.mul_comm]⟩
      · by_cases hr0 : r = 0
        · exact ⟨q, by rw [hqr, hr0, add_zero, CommRing.mul_comm]⟩
        · exact absurd ⟨r, hrI, hr0, rfl⟩ (hmin _ (hgn ▸ hr))
    · rw [hc]; exact I.mul_mem_right c hgI

/-! ## Irreducible elements are prime in a PID -/

/-- The ideal `(p, a) = {p x + a y}` generated by two elements. -/
def Ideal.span2 {R : Type u} [CommRing R] (p a : R) : Ideal R where
  carrier z := ∃ x y, z = p * x + a * y
  zero_mem := ⟨0, 0, by rw [mul_zero, mul_zero, add_zero]⟩
  add_mem := by
    intro z w ⟨x, y, hz⟩ ⟨x', y', hw⟩
    exact ⟨x + x', y + y', by rw [hz, hw, left_distrib, left_distrib]; ac_rfl⟩
  neg_mem := by
    intro z ⟨x, y, hz⟩
    exact ⟨-x, -y, by rw [hz, neg_add, mul_neg, mul_neg]⟩
  mul_mem := by
    intro r z ⟨x, y, hz⟩
    exact ⟨r * x, r * y, by rw [hz, left_distrib]; congr 1 <;> ac_rfl⟩

/-- **Irreducible elements of a PID are prime** (Euclid's lemma for PIDs). If `p` is
irreducible and `p ∣ ab`, then `p ∣ a` or `p ∣ b`. -/
theorem IsPID.irreducible_isPrime {R : Type u} [CommRing R] (hP : IsPID R) {p : R}
    (hp : Irreducible p) : IsPrimeElt p := by
  refine ⟨hp.1, hp.2.1, fun a b hab => ?_⟩
  obtain ⟨d, hd⟩ := hP.2 (Ideal.span2 p a)
  obtain ⟨c, hc⟩ := (hd p).1 ⟨1, 0, by rw [Ring.mul_one, mul_zero, add_zero]⟩
  rcases hp.2.2 d c hc with ⟨d', hd'⟩ | ⟨c', hc'⟩
  · -- `d` is a unit, so `1 ∈ (p, a)`.
    right
    obtain ⟨x, y, hxy⟩ : ∃ x y, d = p * x + a * y := (hd d).2 ⟨1, (Ring.mul_one d).symm⟩
    obtain ⟨k, hk⟩ := hab
    refine ⟨x * d' * b + k * (y * d'), ?_⟩
    calc b = (d * d') * b := by rw [hd', Ring.one_mul]
      _ = (p * x + a * y) * d' * b := by rw [hxy]
      _ = p * (x * d' * b) + (a * b) * (y * d') := by
          rw [right_distrib, right_distrib]; congr 1 <;> ac_rfl
      _ = p * (x * d' * b + k * (y * d')) := by rw [hk, left_distrib]; congr 1; ac_rfl
  · -- `c` is a unit, so `d` is a multiple of `p` and `a ∈ (d)`.
    left
    obtain ⟨e, he⟩ := (hd a).1 ⟨0, 1, by rw [mul_zero, Ring.zero_add, Ring.mul_one]⟩
    refine ⟨c' * e, ?_⟩
    calc a = d * e := he
      _ = (d * c) * c' * e := by rw [Ring.mul_assoc d c c', hc', Ring.mul_one]
      _ = p * (c' * e) := by rw [← hc]; ac_rfl

/-! ## Examples: `ℤ` and `F[x]` -/

/-- `ℤ` is an integral domain. -/
theorem int_isDomain : IsDomain Int :=
  ⟨by decide, fun a b h => Int.mul_eq_zero.1 h⟩

/-- **`ℤ` is a Euclidean domain**, with the absolute value as size. -/
theorem int_isEuclidean : IsEuclidean Int := by
  refine ⟨int_isDomain, Int.natAbs, fun a b hb => ?_⟩
  refine ⟨a / b, a % b, ?_, Or.inr ?_⟩
  · have := Int.emod_add_mul_ediv a b
    show a = a / b * b + a % b
    rw [Int.mul_comm]; omega
  · have h0 := Int.emod_nonneg a hb
    have h1 := Int.emod_lt a hb
    omega

/-- **`ℤ` is a principal ideal domain.** -/
theorem int_isPID : IsPID Int := int_isEuclidean.isPID

/-- **`F[x]` is a Euclidean domain** for every field `F`, with size `deg + 1` (and `0` for
the zero polynomial). -/
theorem polynomial_isEuclidean {F : Type u} [CommRing F] (hF : IsField F) :
    IsEuclidean (Polynomial F) := by
  refine ⟨Polynomial.isDomain hF.isDomain, Polynomial.len, fun a b hb => ?_⟩
  obtain ⟨q, r, hqr, hr⟩ := Polynomial.div_mod hF a b hb
  refine ⟨q, r, hqr, ?_⟩
  by_cases hr0 : r = 0
  · exact Or.inl hr0
  · right
    rcases hr with h | h
    · exact absurd h hr0
    · rw [Polynomial.len_eq_natDegree_succ hr0, Polynomial.len_eq_natDegree_succ hb]; omega

/-- **`F[x]` is a principal ideal domain** for every field `F`. -/
theorem polynomial_isPID {F : Type u} [CommRing F] (hF : IsField F) : IsPID (Polynomial F) :=
  (polynomial_isEuclidean hF).isPID

/-- **Euclid's lemma.** In `ℤ`, irreducible elements are prime: if an irreducible `p` divides
`ab`, it divides `a` or `b`. -/
theorem int_irreducible_isPrime {p : Int} (hp : Irreducible p) : IsPrimeElt p :=
  int_isPID.irreducible_isPrime hp

end Foundations.Algebra
