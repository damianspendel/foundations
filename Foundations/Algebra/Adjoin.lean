import Foundations.Algebra.ComplexField

/-!
# Simple algebraic extensions and the extension of embeddings

Kronecker's construction (1887) of the field `K(γ)` generated by an algebraic element `γ`
underlies all of Galois theory. Inside an ambient field `Ω`, `K(γ)` is the set of values `p(γ)`
of polynomials `p ∈ K[x]`. It is closed under inverses because the polynomials vanishing at `γ`
form a principal ideal `(m)` of `K[x]`, and Bézout's identity `a m + b p = 1` inverts `p(γ)` when
`p(γ) ≠ 0`.

This file develops the facts needed to compute a Galois group inside `ℂ`.

* `mapPoly`: applying a ring homomorphism to the coefficients of a polynomial. It is a ring
  homomorphism, computed by the coefficient formula for products.
* `aeval F γ p = p(γ)` for `p ∈ F[x]`, and the **minimal polynomial** `exists_minpoly`: the
  polynomials vanishing at an algebraic `γ` are the multiples of a single non-zero `m`.
* `adjoin`: the subfield `F(γ) = {p(γ)}`. It contains `F` and `γ` (`le_adjoin`,
  `mem_adjoin_self`), lies in every subfield containing both (`adjoin_le`), and is a **finite
  extension** of `F` (`adjoin_finite`), spanned by `1, γ, …, γ^{deg m - 1}`.
* **Extension of embeddings** (`extend`): a ring homomorphism `σ : F → E` extends to
  `F(γ) → E` sending `γ` to any `δ` that is a root of every `σ(q)` with `q(γ) = 0`. Over
  `E = ℂ` such a `δ` always exists by the fundamental theorem of algebra (`exists_root_C`).
* **Injective endomorphisms of finite extensions are surjective**
  (`ringHom_surjective_of_finite`): a ring homomorphism `L → L` fixing `K` with `[L : K]`
  finite is onto, by counting dimensions.
-/

namespace Foundations.Algebra

open Polynomial Subfield KSubspace VectorSpace FiniteType

universe u v w

/-! ## Mapping coefficients along a ring homomorphism -/

section MapPoly

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B]

/-- Coefficients of a mapped list. -/
theorem PolyList.coeff_map (φ : RingHom A B) (l : List A) (n : Nat) :
    PolyList.coeff (l.map φ.toFun) n = φ.toFun (PolyList.coeff l n) := by
  induction l generalizing n with
  | nil => rw [List.map_nil, PolyList.coeff_nil, PolyList.coeff_nil, φ.map_zero]
  | cons a l ih => cases n with
    | zero => rfl
    | succ n => exact ih n

/-- **Applying a ring homomorphism to the coefficients** of a polynomial. -/
def mapPoly (φ : RingHom A B) (p : Polynomial A) : Polynomial B :=
  Quotient.lift (s := PolyList.setoid A) (fun l => mk (l.map φ.toFun))
    (fun a b h => mk_eq fun n => by
      rw [PolyList.coeff_map, PolyList.coeff_map, (show PolyList.Eqv a b from h) n]) p

/-- Coefficients of a mapped polynomial. -/
theorem coeff_mapPoly (φ : RingHom A B) (p : Polynomial A) (n : Nat) :
    coeff (mapPoly φ p) n = φ.toFun (coeff p n) := by
  induction p using Quotient.ind
  exact PolyList.coeff_map φ _ n

/-- Ring homomorphisms preserve finite sums. -/
theorem RingHom.map_rsum (φ : RingHom A B) (t : Nat → A) :
    ∀ n, φ.toFun (rsum t n) = rsum (fun k => φ.toFun (t k)) n
  | 0 => φ.map_zero
  | n + 1 => by
    show φ.toFun (rsum t n + t n) = rsum _ n + _
    rw [φ.map_add, RingHom.map_rsum φ t n]

/-- Coefficients of the polynomial `1`. -/
theorem coeff_one (n : Nat) : coeff (1 : Polynomial A) n = if n = 0 then 1 else 0 := by
  show PolyList.coeff [1] n = _
  cases n with
  | zero => rfl
  | succ n => rw [PolyList.coeff_cons_succ, PolyList.coeff_nil]; rfl

/-- **`mapPoly φ` is a ring homomorphism** `A[x] → B[x]`. -/
def mapHom (φ : RingHom A B) : RingHom (Polynomial A) (Polynomial B) where
  toFun := mapPoly φ
  map_add p q := ext fun n => by
    rw [coeff_mapPoly, coeff_add, coeff_add, φ.map_add, coeff_mapPoly, coeff_mapPoly]
  map_mul p q := ext fun n => by
    rw [coeff_mapPoly, coeff_mul_sum, coeff_mul_sum, RingHom.map_rsum]
    exact rsum_congr _ fun k _ => by rw [φ.map_mul, coeff_mapPoly, coeff_mapPoly]
  map_one := ext fun n => by
    rw [coeff_mapPoly, coeff_one, coeff_one]
    cases n with
    | zero => exact φ.map_one
    | succ n => exact φ.map_zero

/-- Mapping a constant. -/
theorem mapPoly_C (φ : RingHom A B) (a : A) : mapPoly φ (C a) = C (φ.toFun a) :=
  ext fun n => by rw [coeff_mapPoly, coeff_C, coeff_C]; split
                  · rfl
                  · exact φ.map_zero

/-- Mapping `X`. -/
theorem mapPoly_X (φ : RingHom A B) : mapPoly φ X = X :=
  ext fun n => by
    rw [coeff_mapPoly, coeff_X, coeff_X]; split
    · exact φ.map_one
    · exact φ.map_zero

/-- **Ring homomorphisms commute with evaluation**: `ψ(p(x)) = (ψ p)(ψ x)`. -/
theorem RingHom.map_eval {E : Type w} [CommRing E] (ψ : RingHom B E) (x : B) (p : Polynomial B) :
    ψ.toFun (eval x p) = eval (ψ.toFun x) (mapPoly ψ p) := by
  induction p using Quotient.ind with
  | _ l =>
    show ψ.toFun (evalList x l) = evalList (ψ.toFun x) (l.map ψ.toFun)
    induction l with
    | nil => exact ψ.map_zero
    | cons a l ih =>
      show ψ.toFun (a + x * evalList x l) = ψ.toFun a + ψ.toFun x * evalList _ (l.map ψ.toFun)
      rw [ψ.map_add, ψ.map_mul, ih]

/-- Mapping twice is mapping along the composite. -/
theorem mapPoly_mapPoly {E : Type w} [CommRing E] (φ : RingHom A B) (ψ : RingHom B E)
    (p : Polynomial A) : mapPoly ψ (mapPoly φ p) = mapPoly (ψ.comp φ) p :=
  ext fun n => by rw [coeff_mapPoly, coeff_mapPoly, coeff_mapPoly]; rfl

end MapPoly

/-! ## Evaluation at an element of the ambient field -/

section Aeval

variable {Ω : Type u} [CommRing Ω]

/-- The inclusion `F → Ω` of a subfield. -/
def Subfield.incl (F : Subfield Ω) : RingHom F Ω where
  toFun := Subtype.val
  map_add _ _ := rfl
  map_mul _ _ := rfl
  map_one := rfl

/-- `aeval F γ p = p(γ)`: evaluating a polynomial over a subfield `F` at `γ ∈ Ω`. -/
def aeval (F : Subfield Ω) (γ : Ω) (p : Polynomial F) : Ω := eval γ (mapPoly F.incl p)

/-- Evaluation at `γ` is a ring homomorphism `F[x] → Ω`. -/
def aevalHom (F : Subfield Ω) (γ : Ω) : RingHom (Polynomial F) Ω :=
  (evalHom γ).comp (mapHom F.incl)

variable (F : Subfield Ω) (γ : Ω)

/-- `(p + q)(γ) = p(γ) + q(γ)`. -/
theorem aeval_add (p q : Polynomial F) : aeval F γ (p + q) = aeval F γ p + aeval F γ q :=
  (aevalHom F γ).map_add p q

/-- `(p q)(γ) = p(γ) q(γ)`. -/
theorem aeval_mul (p q : Polynomial F) : aeval F γ (p * q) = aeval F γ p * aeval F γ q :=
  (aevalHom F γ).map_mul p q

/-- `(-p)(γ) = -p(γ)`. -/
theorem aeval_neg (p : Polynomial F) : aeval F γ (-p) = -aeval F γ p :=
  (aevalHom F γ).map_neg p

/-- `0(γ) = 0`. -/
theorem aeval_zero : aeval F γ 0 = 0 := (aevalHom F γ).map_zero

/-- `1(γ) = 1`. -/
theorem aeval_one : aeval F γ 1 = 1 := (aevalHom F γ).map_one

/-- `(C a)(γ) = a`. -/
theorem aeval_C (a : F) : aeval F γ (C a) = a.1 := by
  unfold aeval; rw [mapPoly_C, eval_C]; rfl

/-- `X(γ) = γ`. -/
theorem aeval_X : aeval F γ X = γ := by unfold aeval; rw [mapPoly_X, eval_X]

/-- `γ` is **algebraic** over `F`: a root of a non-zero polynomial over `F`. -/
def IsAlgebraic : Prop := ∃ q : Polynomial F, q ≠ 0 ∧ aeval F γ q = 0

/-- Values of `p(γ)` lie in every subfield containing the coefficients of `p` and `γ`. -/
theorem aeval_mem {M : Subfield Ω} (hFM : F.le M) (hγ : γ ∈ M) (p : Polynomial F) :
    aeval F γ p ∈ M := by
  induction p using Quotient.ind with
  | _ l =>
    show evalList γ (l.map F.incl.toFun) ∈ M
    induction l with
    | nil => exact M.zero_mem
    | cons a l ih => exact M.add_mem (hFM _ a.2) (M.mul_mem hγ ih)

/-- **The minimal polynomial.** If `γ` is algebraic over `F`, the polynomials vanishing at `γ`
are exactly the multiples of a single non-zero polynomial `m`. -/
theorem exists_minpoly (hΩ : IsField Ω) (hγ : IsAlgebraic F γ) :
    ∃ m : Polynomial F, m ≠ 0 ∧ ∀ q, aeval F γ q = 0 ↔ Divides m q := by
  obtain ⟨m, hm⟩ := (polynomial_isPID (F.isField hΩ)).2 (RingHom.ker (aevalHom F γ))
  refine ⟨m, ?_, fun q => hm q⟩
  intro h0
  obtain ⟨q, hq0, hq⟩ := hγ
  obtain ⟨c, rfl⟩ := (hm q).1 hq
  rw [h0, Ring.zero_mul] at hq0; exact hq0 rfl

/-- **Inverses in `F[γ]`** (via Bézout). If `p(γ) ≠ 0` then `p(γ) · y(γ) = 1` for some `y`. -/
theorem aeval_inverse (hΩ : IsField Ω) (hγ : IsAlgebraic F γ) (p : Polynomial F)
    (hp : aeval F γ p ≠ 0) : ∃ y : Polynomial F, aeval F γ p * aeval F γ y = 1 := by
  have hP := polynomial_isPID (F.isField hΩ)
  obtain ⟨m, hm0, hm⟩ := exists_minpoly F γ hΩ hγ
  obtain ⟨d, hd⟩ := hP.2 (Ideal.span2 m p)
  obtain ⟨c, hc⟩ := (hd m).1 ⟨1, 0, by rw [Ring.mul_one, Ring.mul_zero, Ring.add_zero]⟩
  have hmz : aeval F γ m = 0 := (hm m).2 ⟨1, (Ring.mul_one m).symm⟩
  rw [hc, aeval_mul] at hmz
  rcases hΩ.isDomain.2 _ _ hmz with h | h
  · -- `m ∣ d ∣ p`, so `p(γ) = 0`
    exfalso; apply hp
    obtain ⟨e, he⟩ := (hd p).1 ⟨0, 1, by rw [Ring.mul_zero, Ring.zero_add, Ring.mul_one]⟩
    rw [he, aeval_mul, h, Ring.zero_mul]
  · -- `c = m c'`, so `d c' = 1` and `1 ∈ (m, p)`
    obtain ⟨c', hc'⟩ := (hm c).1 h
    have hdc : d * c' = 1 := by
      have e : m * (d * c' + -1) = 0 := by
        have : m = m * (d * c') :=
          calc m = d * c := hc
            _ = d * (m * c') := by rw [hc']
            _ = m * (d * c') := by ac_rfl
        grind
      rcases hP.1.2 _ _ e with h1 | h1
      · exact absurd h1 hm0
      · grind
    obtain ⟨x, y, hxy⟩ := (show ∃ x y, d = m * x + p * y from (hd d).2 ⟨1, (Ring.mul_one d).symm⟩)
    refine ⟨y * c', ?_⟩
    have h1 : aeval F γ (d * c') = 1 := by rw [hdc, aeval_one]
    rw [hxy, aeval_mul, aeval_add, aeval_mul, aeval_mul, (hm m).2 ⟨1, (Ring.mul_one m).symm⟩] at h1
    rw [aeval_mul, ← h1]; grind

end Aeval

/-! ## The field `F(γ)` -/

section Adjoin

variable {Ω : Type u} [CommRing Ω] (hΩ : IsField Ω) (F : Subfield Ω) (γ : Ω)
  (hγ : IsAlgebraic F γ)

/-- **The simple extension `F(γ)`**: the values `p(γ)` of polynomials `p ∈ F[x]`, for `γ`
algebraic over `F`. -/
def adjoin : Subfield Ω where
  carrier x := ∃ p, aeval F γ p = x
  zero_mem := ⟨0, aeval_zero F γ⟩
  one_mem := ⟨1, aeval_one F γ⟩
  add_mem := fun ⟨p, hp⟩ ⟨q, hq⟩ => ⟨p + q, by rw [aeval_add, hp, hq]⟩
  neg_mem := fun ⟨p, hp⟩ => ⟨-p, by rw [aeval_neg, hp]⟩
  mul_mem := fun ⟨p, hp⟩ ⟨q, hq⟩ => ⟨p * q, by rw [aeval_mul, hp, hq]⟩
  inv_mem := by
    intro x ⟨p, hp⟩ hx
    obtain ⟨y, hy⟩ := aeval_inverse F γ hΩ hγ p (by rw [hp]; exact hx)
    exact ⟨aeval F γ y, ⟨y, rfl⟩, by rw [← hp]; exact hy⟩

/-- `F ⊆ F(γ)`. -/
theorem le_adjoin : F.le (adjoin hΩ F γ hγ) := fun x hx => ⟨C ⟨x, hx⟩, aeval_C F γ _⟩

/-- `γ ∈ F(γ)`. -/
theorem mem_adjoin_self : γ ∈ adjoin hΩ F γ hγ := ⟨X, aeval_X F γ⟩

/-- `F(γ)` is the smallest subfield containing `F` and `γ`. -/
theorem adjoin_le {M : Subfield Ω} (hFM : F.le M) (hγM : γ ∈ M) : (adjoin hΩ F γ hγ).le M :=
  fun _ ⟨p, hp⟩ => hp ▸ aeval_mem F γ hFM hγM p

/-- Evaluation as a finite sum: if `deg p < N` then `p(x) = ∑_{i < N} pᵢ xⁱ`. -/
theorem eval_eq_rsum {B : Type v} [CommRing B] (x : B) :
    ∀ (l : List B) (N : Nat), (∀ i, N ≤ i → PolyList.coeff l i = 0) →
      evalList x l = rsum (fun i => PolyList.coeff l i * rpow x i) N := by
  intro l
  induction l with
  | nil =>
    intro N _; show (0 : B) = _
    rw [rsum_zero]; intro k _; rw [PolyList.coeff_nil, Ring.zero_mul]
  | cons a l ih =>
    intro N hN
    cases N with
    | zero =>
      have : PolyList.Eqv (a :: l) [] := fun k => by rw [hN k (Nat.zero_le k), PolyList.coeff_nil]
      exact evalList_of_eqv_nil x this
    | succ N =>
      rw [rsum_succ']
      show a + x * evalList x l = a * rpow x 0 + _
      rw [ih N (fun i hi => hN (i + 1) (by omega)), mul_rsum]
      have e : rsum (fun k => x * (PolyList.coeff l k * rpow x k)) N =
          rsum (fun k => PolyList.coeff (a :: l) (k + 1) * rpow x (k + 1)) N :=
        rsum_congr _ fun k _ => by
          rw [PolyList.coeff_cons_succ]; show _ = _ * (rpow x k * x); grind
      rw [e]; show _ = a * 1 + _; grind

/-- A sum over `Fin N` is the sum over `0, …, N - 1`. -/
theorem isum_fin_eq_rsum {B : Type v} [CommRing B] :
    ∀ (N : Nat) (t : Nat → B), isum (fun i : Fin N => t i.val) = rsum t N
  | 0, _ => rfl
  | N + 1, t => by
    rw [isum_fin_succ, rsum_succ']
    show t 0 + isum (fun i : Fin N => t (i.val + 1)) = _
    rw [isum_fin_eq_rsum N (fun k => t (k + 1))]

/-- Evaluation as a finite sum, for polynomials: if `deg p < N` then `p(x) = ∑_{i < N} pᵢ xⁱ`. -/
theorem eval_eq_rsum' {B : Type v} [CommRing B] (x : B) (p : Polynomial B) {N : Nat}
    (h : DegLT p N) : eval x p = rsum (fun i => coeff p i * rpow x i) N := by
  induction p using Quotient.ind with
  | _ l => exact eval_eq_rsum x l N h

/-- Powers of an element of a subfield lie in it. -/
theorem rpow_mem {M : Subfield Ω} {x : Ω} (hx : x ∈ M) : ∀ n, rpow x n ∈ M
  | 0 => M.one_mem
  | n + 1 => M.mul_mem (rpow_mem hx n) hx

/-- **`F(γ)` is a finite extension of `F`**, spanned by `1, γ, …, γ^{N-1}` where `N` is the degree
of the minimal polynomial. -/
theorem adjoin_finite : FiniteExt F (adjoin hΩ F γ hγ) (le_adjoin hΩ F γ hγ) := by
  obtain ⟨m, hm0, hm⟩ := exists_minpoly F γ hΩ hγ
  let A := adjoin hΩ F γ hγ
  let u : Fin (natDegree m) → A.over F (le_adjoin hΩ F γ hγ) := fun i =>
    ⟨rpow γ i.val, rpow_mem (mem_adjoin_self hΩ F γ hγ) i.val⟩
  refine ⟨natDegree m, u, fun x => ?_⟩
  obtain ⟨p, hp⟩ := x.2
  obtain ⟨q, r, hqr, hr⟩ := div_mod (F.isField hΩ) p m hm0
  have hrd : DegLT r (natDegree m) := by
    by_cases hr0 : r = 0
    · rw [hr0]; intro n _; exact coeff_zero n
    · rcases hr with h | h
      · exact absurd h hr0
      · exact (degLT_natDegree hr0).mono (by omega)
  have hpr : aeval F γ p = aeval F γ r := by
    rw [hqr, aeval_add, aeval_mul, (hm m).2 ⟨1, (Ring.mul_one m).symm⟩, Ring.mul_zero,
      Ring.zero_add]
  refine ⟨fun i => coeff r i.val, Subtype.ext ?_⟩
  rw [KSubspace.coe_isum]
  show x.1 = isum (fun i : Fin (natDegree m) => (coeff r i.val).1 * rpow γ i.val)
  rw [isum_fin_eq_rsum (natDegree m) (fun k => (coeff r k).1 * rpow γ k), ← hp, hpr]
  unfold aeval
  rw [eval_eq_rsum' γ _ (N := natDegree m) (fun n hn => by rw [coeff_mapPoly, hrd n hn]; rfl)]
  exact rsum_congr _ fun k _ => by rw [coeff_mapPoly]; rfl

end Adjoin

end Foundations.Algebra
