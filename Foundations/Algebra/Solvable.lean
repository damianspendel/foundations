import Foundations.Algebra.A5

/-!
# Solvable groups: `Sₙ` is not solvable for `n ≥ 5`

Galois's criterion says that a polynomial equation is solvable by radicals exactly when its
group is **solvable**: when it can be dismantled by repeatedly passing to commutator subgroups
until nothing is left. The **commutator** of `x` and `y` is `[x, y] = x y x⁻¹ y⁻¹`; it measures
the failure of `x` and `y` to commute. The commutator subgroup `G'` is the subgroup generated by
all commutators, and the **derived series** is `G ⊇ G' ⊇ G'' ⊇ ⋯`. A group is solvable if this
series reaches the trivial group.

For `n ≥ 5` it never does for `Sₙ`, and the reason is a small identity: for five distinct
letters,

  `(a b c) = [(a b d), (a c e)]`,

so every 3-cycle is a commutator of 3-cycles. By induction every term of the derived series
contains all 3-cycles, and so is never trivial. With Galois's criterion (not formalised here),
this is the reason the general equation of degree five or more has no solution by radicals.
-/

namespace Foundations.Algebra

open Group Perm

universe u

/-! ## Generated subgroups and the derived series -/

/-- The elements obtainable from `S` by products, inverses and `1`. -/
inductive Closure {G : Type u} [Group G] (S : G → Prop) : G → Prop
  | of {x : G} : S x → Closure S x
  | one : Closure S 1
  | mul {x y : G} : Closure S x → Closure S y → Closure S (x * y)
  | inv {x : G} : Closure S x → Closure S x⁻¹

/-- The **subgroup generated** by a set `S`. -/
def Subgroup.closure {G : Type u} [Group G] (S : G → Prop) : Subgroup G where
  carrier := Closure S
  one_mem := Closure.one
  mul_mem := Closure.mul
  inv_mem := Closure.inv

/-- The **commutator** `[x, y] = x y x⁻¹ y⁻¹`. -/
def commutator {G : Type u} [Group G] (x y : G) : G := x * y * x⁻¹ * y⁻¹

/-- The **commutator subgroup** `[H, H]` of a subgroup `H`, generated by the commutators of its
elements. -/
def commutatorSubgroup {G : Type u} [Group G] (H : Subgroup G) : Subgroup G :=
  Subgroup.closure fun z => ∃ x y, x ∈ H ∧ y ∈ H ∧ z = commutator x y

/-- The **derived series** `G = G⁽⁰⁾ ⊇ G⁽¹⁾ ⊇ ⋯`, with `G⁽ᵏ⁺¹⁾ = [G⁽ᵏ⁾, G⁽ᵏ⁾]`. -/
def derivedSeries (G : Type u) [Group G] : Nat → Subgroup G
  | 0 => Subgroup.top
  | k + 1 => commutatorSubgroup (derivedSeries G k)

/-- A group is **solvable** if its derived series reaches the trivial subgroup. -/
def IsSolvable (G : Type u) [Group G] : Prop := ∃ k, ∀ x, x ∈ derivedSeries G k → x = 1

/-- Commutative groups are solvable: their commutator subgroup is already trivial. -/
theorem CommGroup.isSolvable (G : Type u) [CommGroup G] : IsSolvable G := by
  refine ⟨1, fun x hx => ?_⟩
  induction hx with
  | of h =>
    obtain ⟨a, b, _, _, rfl⟩ := h
    show a * b * a⁻¹ * b⁻¹ = 1
    rw [CommGroup.mul_comm a b, mul_inv_cancel_right, mul_inv_cancel]
  | one => rfl
  | mul _ _ h1 h2 => rw [h1, h2, one_mul]
  | inv _ h => rw [h, inv_one]

/-! ## Every 3-cycle is a commutator -/

/-- The inverse of `(a b c)` is `(a c b)`. -/
theorem c3_inv {n : Nat} {a b c : Fin n} (hab : a ≠ b) (hbc : b ≠ c) (hac : a ≠ c) :
    (c3 a b c)⁻¹ = c3 a c b := by
  have := Ne.symm hab; have := Ne.symm hac; have := Ne.symm hbc
  apply inv_eq_of_mul_eq_one
  apply ext; intro x
  simp only [mul_apply, one_apply, c3_apply hab hbc hac, c3_apply hac (Ne.symm hbc) hab]
  by_cases h1 : x = a
  · subst h1; simp [*]
  · by_cases h2 : x = b
    · subst h2; simp [*]
    · by_cases h3 : x = c
      · subst h3; simp [*]
      · simp [h1, h2, h3]

/-- **Every 3-cycle is a commutator of 3-cycles**: for distinct `a, b, c, d, e`,
`(a b c) = [(a b d), (a c e)]`. -/
theorem c3_eq_commutator {n : Nat} {a b c d e : Fin n}
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hae : a ≠ e) (hbc : b ≠ c) (hbd : b ≠ d)
    (hbe : b ≠ e) (hcd : c ≠ d) (hce : c ≠ e) (hde : d ≠ e) :
    c3 a b c = commutator (c3 a b d) (c3 a c e) := by
  unfold commutator
  rw [c3_inv hab hbd had, c3_inv hac hce hae]
  apply ext; intro x
  simp only [mul_apply, c3_apply hab hbc hac, c3_apply hab hbd had, c3_apply hac hce hae,
    c3_apply had (Ne.symm hbd) hab, c3_apply hae (Ne.symm hce) hac]
  have := Ne.symm hab; have := Ne.symm hac; have := Ne.symm had; have := Ne.symm hae
  have := Ne.symm hbc; have := Ne.symm hbd; have := Ne.symm hbe; have := Ne.symm hcd
  have := Ne.symm hce; have := Ne.symm hde
  by_cases h1 : x = a
  · subst h1; simp [*]
  · by_cases h2 : x = b
    · subst h2; simp [*]
    · by_cases h3 : x = c
      · subst h3; simp [*]
      · by_cases h4 : x = d
        · subst h4; simp [*]
        · by_cases h5 : x = e
          · subst h5; simp [*]
          · simp [*]

/-- Among `0, 1, 2, 3` some number avoids three given numbers. -/
theorem avoid3 (a b c : Nat) : ∃ d, d < 4 ∧ d ≠ a ∧ d ≠ b ∧ d ≠ c :=
  if h : 0 ≠ a ∧ 0 ≠ b ∧ 0 ≠ c then ⟨0, by omega, h⟩
  else if h : 1 ≠ a ∧ 1 ≠ b ∧ 1 ≠ c then ⟨1, by omega, h⟩
  else if h : 2 ≠ a ∧ 2 ≠ b ∧ 2 ≠ c then ⟨2, by omega, h⟩
  else ⟨3, by omega, by omega⟩

/-- Among `0, …, 4` some number avoids four given numbers. -/
theorem avoid4 (a b c d : Nat) : ∃ e, e < 5 ∧ e ≠ a ∧ e ≠ b ∧ e ≠ c ∧ e ≠ d :=
  if h : 0 ≠ a ∧ 0 ≠ b ∧ 0 ≠ c ∧ 0 ≠ d then ⟨0, by omega, h⟩
  else if h : 1 ≠ a ∧ 1 ≠ b ∧ 1 ≠ c ∧ 1 ≠ d then ⟨1, by omega, h⟩
  else if h : 2 ≠ a ∧ 2 ≠ b ∧ 2 ≠ c ∧ 2 ≠ d then ⟨2, by omega, h⟩
  else if h : 3 ≠ a ∧ 3 ≠ b ∧ 3 ≠ c ∧ 3 ≠ d then ⟨3, by omega, h⟩
  else ⟨4, by omega, by omega⟩

/-- **Every term of the derived series of `Sₙ` (`n ≥ 5`) contains every 3-cycle.** -/
theorem c3_mem_derivedSeries {n : Nat} (hn : 5 ≤ n) :
    ∀ k (a b c : Fin n), a ≠ b → b ≠ c → a ≠ c → c3 a b c ∈ derivedSeries (Perm (Fin n)) k := by
  intro k
  induction k with
  | zero => intro _ _ _ _ _ _; trivial
  | succ k ih =>
    intro a b c hab hbc hac
    have hv : ∀ {x y : Fin n}, x.val ≠ y.val → x ≠ y := fun h e => h (congrArg Fin.val e)
    have hv' : ∀ {x y : Fin n}, x ≠ y → x.val ≠ y.val := fun h e => h (Fin.ext e)
    obtain ⟨d, hd4, hda, hdb, hdc⟩ := avoid3 a.val b.val c.val
    obtain ⟨e, he5, hea, heb, hec, hed⟩ := avoid4 a.val b.val c.val d
    let D : Fin n := ⟨d, by omega⟩
    let E : Fin n := ⟨e, by omega⟩
    have hdE : D ≠ E := hv (show d ≠ e from Ne.symm hed)
    rw [c3_eq_commutator hab hac (hv (Ne.symm hda)) (hv (Ne.symm hea)) hbc
      (hv (Ne.symm hdb)) (hv (Ne.symm heb)) (hv (Ne.symm hdc)) (hv (Ne.symm hec)) hdE]
    exact Closure.of ⟨_, _, ih a b D hab (hv (Ne.symm hdb)) (hv (Ne.symm hda)),
      ih a c E hac (hv (Ne.symm hec)) (hv (Ne.symm hea)), rfl⟩

/-- **`Sₙ` is not solvable for `n ≥ 5`.** Every term of its derived series contains the
3-cycle `(0 1 2)`, which is not the identity. (Together with Galois's criterion, this is why
the general equation of degree `n ≥ 5` is not solvable by radicals.) -/
theorem symmetric_not_solvable {n : Nat} (hn : 5 ≤ n) : ¬ IsSolvable (Perm (Fin n)) := by
  intro ⟨k, hk⟩
  let a : Fin n := ⟨0, by omega⟩
  let b : Fin n := ⟨1, by omega⟩
  let c : Fin n := ⟨2, by omega⟩
  have hab : a ≠ b := fun h => absurd (congrArg Fin.val h) (by simp [a, b])
  have hbc : b ≠ c := fun h => absurd (congrArg Fin.val h) (by simp [b, c])
  have hac : a ≠ c := fun h => absurd (congrArg Fin.val h) (by simp [a, c])
  exact c3_ne_one hab hbc hac (hk _ (c3_mem_derivedSeries hn k a b c hab hbc hac))

end Foundations.Algebra
