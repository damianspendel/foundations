import Foundations.Algebra.Kummer

/-!
# Radical towers

A complex number is **expressible by radicals** over `ℚ` if it can be written using rational
numbers, the four field operations and root extractions `ⁿ√·`. Equivalently, it lies in a
**radical tower**

  `ℚ = K₀ ⊆ K₁ ⊆ ⋯ ⊆ Kₘ ⊆ ℂ`,  `K_{i+1} = Kᵢ(xᵢ₊₁)` with `xᵢ₊₁^{nᵢ₊₁} ∈ Kᵢ` (`nᵢ₊₁ ≥ 1`),

each step adjoining an `n`-th root of an element already constructed. This file sets up the
language for such towers inside `ℂ`.

* `adj K x` is `K(x)` when `x` is algebraic over `K` (and `K` otherwise, a harmless default that
  makes the operation total); `gen K [xₘ, …, x₁]` is the iterated adjunction `K(x₁)(x₂)⋯(xₘ)`.
  Lists are written **newest element first**, so that `gen K (x :: l) = (gen K l)(x)`.
* `RadicalChain l` says that each element of `l` has a positive power in the field generated
  by the elements before it; `ExpressibleByRadicals z` says that `z ∈ gen ℚ l` for such a chain.
  For radical chains `gen ℚ l` really is `ℚ(x₁, …, xₘ)`: it contains every `xᵢ`
  (`RadicalChain.mem`) and lies in every subfield containing `ℚ` and the `xᵢ` (`gen_le`).
* `KummerChain l` is the refined notion used in the proof: every step is a radical step of prime
  degree in the sense of `Kummer` (a root of unity, or a radical over a field that already holds
  the relevant roots of unity).

The general facts proved here are the ones the proof of Galois's criterion needs:

* `gen K l` is a **finite extension** of `K` (`gen_finite`);
* **every embedding extends**: a ring homomorphism `K → ℂ` extends to `gen K l → ℂ`
  (`extend_gen`), by the fundamental theorem of algebra, one simple extension at a time;
* an automorphism that fixes `K` and `x` **fixes `K(x)`** (`fixes_adj`);
* the elements of a subfield sent into a subfield `M` by an embedding form a subfield
  (`preimage`), the device for showing that an embedding maps one field into another.
-/

namespace Foundations.Algebra

open Polynomial Subfield

universe u

/-- The complex numbers of Part II. -/
local notation "ℂ" => Foundations.Numbers.C

/-! ## Preliminaries -/

/-- The inclusion `A → B` of subfields `A ⊆ B`, as a ring homomorphism. -/
def Subfield.inclusion {Ω : Type u} [CommRing Ω] {A B : Subfield Ω} (h : A.le B) : RingHom A B where
  toFun x := ⟨x.1, h _ x.2⟩
  map_add _ _ := rfl
  map_mul _ _ := rfl
  map_one := rfl

/-- Finiteness of an extension depends only on the subfields, not on the inclusion proof. -/
theorem finiteExt_congr {Ω : Type u} [CommRing Ω] {K M M' : Subfield Ω} (e : M = M')
    {h : K.le M} {h' : K.le M'} (hf : FiniteExt K M h) : FiniteExt K M' h' := by
  subst e; exact hf

/-- Applying a ring homomorphism to the coefficients of a binomial. -/
theorem mapPoly_binomial {A B : Type u} [CommRing A] [CommRing B] (φ : RingHom A B) (c : A)
    (n : Nat) : mapPoly φ (binomial c n) = binomial (φ.toFun c) n := by
  show mk ((-c :: (List.replicate n 0 ++ [1])).map φ.toFun) = mk (-(φ.toFun c) :: _)
  simp [List.map_append, List.map_replicate, RingHom.map_neg, RingHom.map_zero, φ.map_one]

/-- **Algebraic over a smaller field means algebraic over a larger one.** -/
theorem IsAlgebraic.mono {K K' : Subfield ℂ} (h : K.le K') {x : ℂ} (hx : IsAlgebraic K x) :
    IsAlgebraic K' x := by
  obtain ⟨q, hq0, hq⟩ := hx
  refine ⟨mapPoly (Subfield.inclusion h) q, fun h0 => hq0 (Polynomial.ext fun n => ?_), ?_⟩
  · have := congrArg (fun r => coeff r n) h0
    simp only [coeff_mapPoly] at this
    have h1 : ((Subfield.inclusion h).toFun (coeff q n)).1 = (coeff (0 : Polynomial K') n).1 :=
      congrArg Subtype.val this
    exact Subtype.ext h1
  · show eval x (mapPoly K'.incl (mapPoly _ q)) = 0
    rw [mapPoly_mapPoly]; exact hq

/-- **Radicals are algebraic**: if `xⁿ ∈ K` with `n ≥ 1`, then `x` is a root of
`Xⁿ - xⁿ ∈ K[X]`. -/
theorem isAlgebraic_of_rpow {K : Subfield ℂ} {x : ℂ} {n : Nat} (hn : 0 < n) (h : rpow x n ∈ K) :
    IsAlgebraic K x := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  refine ⟨binomial ⟨rpow x (k + 1), h⟩ k, binomial_ne_zero (K.isField C.isField).1 _ k, ?_⟩
  show eval x (mapPoly K.incl (binomial _ k)) = 0
  rw [mapPoly_binomial, eval_binomial]
  show rpow x (k + 1) + -rpow x (k + 1) = 0
  grind

/-! ## Adjoining one element, and a list of elements -/

open Classical in
/-- **`K(x)`**: the field generated by `K` and `x` if `x` is algebraic over `K`, and `K` itself
otherwise (a default never used for the radicals below, which are always algebraic). -/
noncomputable def adj (K : Subfield ℂ) (x : ℂ) : Subfield ℂ :=
  if h : IsAlgebraic K x then adjoin C.isField K x h else K

/-- For algebraic `x`, `adj K x` is the simple extension `K(x)`. -/
theorem adj_of_alg {K : Subfield ℂ} {x : ℂ} (h : IsAlgebraic K x) :
    adj K x = adjoin C.isField K x h := by
  unfold adj; exact dite_eq_left h

/-- For non-algebraic `x`, `adj K x = K`. -/
theorem adj_of_not_alg {K : Subfield ℂ} {x : ℂ} (h : ¬ IsAlgebraic K x) : adj K x = K := by
  unfold adj; exact dite_eq_right h

/-- `K ⊆ K(x)`. -/
theorem le_adj (K : Subfield ℂ) (x : ℂ) : K.le (adj K x) := by
  by_cases h : IsAlgebraic K x
  · rw [adj_of_alg h]; exact le_adjoin _ _ _ _
  · rw [adj_of_not_alg h]; exact le_refl K

/-- `x ∈ K(x)` for algebraic `x`. -/
theorem mem_adj {K : Subfield ℂ} {x : ℂ} (h : IsAlgebraic K x) : x ∈ adj K x := by
  rw [adj_of_alg h]; exact mem_adjoin_self _ _ _ _

/-- `K(x)` lies in every subfield containing `K` and (if `x` is algebraic over `K`) `x`. -/
theorem adj_le {K M : Subfield ℂ} {x : ℂ} (hKM : K.le M) (hx : IsAlgebraic K x → x ∈ M) :
    (adj K x).le M := by
  by_cases h : IsAlgebraic K x
  · rw [adj_of_alg h]; exact adjoin_le _ _ _ _ hKM (hx h)
  · rw [adj_of_not_alg h]; exact hKM

/-- `K(x)` is a finite extension of `K`. -/
theorem adj_finite (K : Subfield ℂ) (x : ℂ) : FiniteExt K (adj K x) (le_adj K x) := by
  by_cases h : IsAlgebraic K x
  · exact finiteExt_congr (adj_of_alg h).symm (adjoin_finite C.isField K x h)
  · exact finiteExt_congr (adj_of_not_alg h).symm (deg_self C.isField K).1

/-- **Iterated adjunction** `gen K [xₘ, …, x₁] = K(x₁)(x₂)⋯(xₘ)` (newest element first). -/
noncomputable def gen (K : Subfield ℂ) : List ℂ → Subfield ℂ
  | [] => K
  | x :: l => adj (gen K l) x

/-- `K ⊆ gen K l`. -/
theorem le_gen (K : Subfield ℂ) : ∀ l, K.le (gen K l)
  | [] => le_refl K
  | x :: l => le_trans (le_gen K l) (le_adj _ x)

/-- Adjoining more elements gives a larger field. -/
theorem gen_le_cons (K : Subfield ℂ) (x : ℂ) (l : List ℂ) : (gen K l).le (gen K (x :: l)) :=
  le_adj _ x

/-- Adjoining a list in two stages. -/
theorem gen_append (K : Subfield ℂ) : ∀ a l : List ℂ, gen K (a ++ l) = gen (gen K l) a
  | [], _ => rfl
  | x :: a, l => by show adj (gen K (a ++ l)) x = adj (gen (gen K l) a) x; rw [gen_append K a l]

/-- `gen K l ⊆ gen K (a ++ l)`. -/
theorem gen_le_append (K : Subfield ℂ) (a l : List ℂ) : (gen K l).le (gen K (a ++ l)) := by
  rw [gen_append]; exact le_gen _ a

/-- **Minimality**: `gen K l` lies in every subfield containing `K` and the elements of `l`. -/
theorem gen_le {K M : Subfield ℂ} (hKM : K.le M) : ∀ l : List ℂ, (∀ x, x ∈ l → x ∈ M) →
    (gen K l).le M
  | [], _ => hKM
  | x :: l, h => adj_le (gen_le hKM l fun y hy => h y (List.mem_cons_of_mem x hy))
      fun _ => h x List.mem_cons_self

/-- **Monotonicity in the base**: `K ⊆ K'` implies `gen K l ⊆ gen K' l`. -/
theorem gen_mono_base {K K' : Subfield ℂ} (h : K.le K') : ∀ l, (gen K l).le (gen K' l)
  | [] => h
  | x :: l => adj_le (le_trans (gen_mono_base h l) (le_adj _ x))
      fun halg => mem_adj (halg.mono (gen_mono_base h l))

/-- **`gen K l` is a finite extension of `K`** (tower law, one step at a time). -/
theorem gen_finite (K : Subfield ℂ) : ∀ l, FiniteExt K (gen K l) (le_gen K l)
  | [] => (deg_self C.isField K).1
  | x :: l => (tower_law C.isField (le_gen K l) (le_adj _ x) (gen_finite K l)
      (adj_finite _ x)).1

/-! ## Radical chains -/

/-- **Radical chain** (newest element first): each element `x` of the list has a power `xⁿ`
(`n ≥ 1`) in the field generated over `ℚ` by the elements after it. -/
inductive RadicalChain : List ℂ → Prop
  /-- The empty chain. -/
  | nil : RadicalChain []
  /-- Adjoin an `n`-th root of an element of the field built so far. -/
  | cons {x : ℂ} {l : List ℂ} (n : Nat) : 0 < n → rpow x n ∈ gen Qc l → RadicalChain l →
      RadicalChain (x :: l)

/-- **Expressible by radicals** over `ℚ`: `z` lies in a radical tower
`ℚ ⊆ ℚ(x₁) ⊆ ℚ(x₁, x₂) ⊆ ⋯ ⊆ ℚ(x₁, …, xₘ)` with `xᵢ^{nᵢ} ∈ ℚ(x₁, …, xᵢ₋₁)`, `nᵢ ≥ 1`. -/
def ExpressibleByRadicals (z : ℂ) : Prop := ∃ l, RadicalChain l ∧ z ∈ gen Qc l

/-- In a radical chain every element lies in the generated field, which is therefore exactly
`ℚ(x₁, …, xₘ)` (by `gen_le`). -/
theorem RadicalChain.mem {l : List ℂ} (h : RadicalChain l) : ∀ x, x ∈ l → x ∈ gen Qc l := by
  induction h with
  | nil => intro x hx; cases hx
  | cons n hn hx _ ih =>
    intro y hy
    rcases List.mem_cons.1 hy with rfl | hy
    · exact mem_adj (isAlgebraic_of_rpow hn hx)
    · exact gen_le_cons _ _ _ _ (ih y hy)

/-- **Kummer chain**: a radical chain all of whose steps are radical steps of prime degree in
the sense of `KummerStep` (roots of unity, or radicals over a field already containing the
corresponding roots of unity). -/
inductive KummerChain : List ℂ → Prop
  /-- The empty chain. -/
  | nil : KummerChain []
  /-- Adjoin a radical step of prime degree `p`. -/
  | cons {x : ℂ} {l : List ℂ} (p : Nat) : KummerStep (gen Qc l) x p → KummerChain l →
      KummerChain (x :: l)

/-- In a Kummer chain every element lies in the generated field. -/
theorem KummerChain.mem {l : List ℂ} (h : KummerChain l) : ∀ x, x ∈ l → x ∈ gen Qc l := by
  induction h with
  | nil => intro x hx; cases hx
  | cons p hs _ ih =>
    intro y hy
    rcases List.mem_cons.1 hy with rfl | hy
    · exact mem_adj (isAlgebraic_of_rpow (by have := hs.1.1; omega) hs.rpow_mem)
    · exact gen_le_cons _ _ _ _ (ih y hy)

/-- A final segment of a Kummer chain is a Kummer chain. -/
theorem KummerChain.of_append : ∀ (a : List ℂ) {l : List ℂ}, KummerChain (a ++ l) → KummerChain l
  | [], _, h => h
  | _ :: a, _, h => by cases h with | cons _ _ h' => exact KummerChain.of_append a h'

/-! ## Extending embeddings -/

/-- **Extension along `K ⊆ K(x)`.** Every ring homomorphism `σ : K → ℂ` extends to
`K(x) → ℂ` (by `extend` and the fundamental theorem of algebra). -/
theorem extend_adj (K : Subfield ℂ) (x : ℂ) (σ : RingHom K ℂ) :
    ∃ τ : RingHom (adj K x) ℂ, ∀ y : K, τ.toFun ⟨y.1, le_adj K x _ y.2⟩ = σ.toFun y := by
  by_cases h : IsAlgebraic K x
  · obtain ⟨δ, hδ⟩ := exists_root_C C.isField K x h σ
    obtain ⟨τ₀, hτ₀, _, _⟩ := extend C.isField K x h σ δ hδ
    have hle : (adj K x).le (adjoin C.isField K x h) := by rw [adj_of_alg h]; exact le_refl _
    exact ⟨τ₀.comp (Subfield.inclusion hle), fun y => hτ₀ y⟩
  · have hle : (adj K x).le K := by rw [adj_of_not_alg h]; exact le_refl _
    exact ⟨σ.comp (Subfield.inclusion hle), fun y => rfl⟩

/-- **Extension along `K ⊆ gen K l`.** Every ring homomorphism `K → ℂ` extends to
`gen K l → ℂ`. -/
theorem extend_gen (K : Subfield ℂ) (σ : RingHom K ℂ) :
    ∀ l, ∃ τ : RingHom (gen K l) ℂ, ∀ y : K, τ.toFun ⟨y.1, le_gen K l _ y.2⟩ = σ.toFun y
  | [] => ⟨σ, fun _ => rfl⟩
  | x :: l => by
    obtain ⟨τ', hτ'⟩ := extend_gen K σ l
    obtain ⟨τ, hτ⟩ := extend_adj (gen K l) x τ'
    exact ⟨τ, fun y => (hτ ⟨y.1, le_gen K l _ y.2⟩).trans (hτ' y)⟩

/-- **Extension to `ℚ(x₁, …, xₘ)` from an intermediate field.** If `ℚ ⊆ F ⊆ gen ℚ m`, every
ring homomorphism `F → ℂ` extends to `gen ℚ m → ℂ`: indeed `gen ℚ m ⊆ gen F m`. -/
theorem extend_to {F : Subfield ℂ} (m : List ℂ) (hQF : Qc.le F) (hFM : F.le (gen Qc m))
    (σ : RingHom F ℂ) :
    ∃ τ : RingHom (gen Qc m) ℂ, ∀ y : F, τ.toFun ⟨y.1, hFM _ y.2⟩ = σ.toFun y := by
  obtain ⟨τ', hτ'⟩ := extend_gen F σ m
  exact ⟨τ'.comp (Subfield.inclusion (gen_mono_base hQF m)), fun y => hτ' y⟩

/-! ## Fixing and mapping generated fields -/

/-- **Automorphisms fixing generators fix the generated field.** If `σ ∈ Aut(M/F)` fixes `K` and
`x` (with `K ⊆ M`, `x ∈ M`), then `σ` fixes `K(x)`. -/
theorem fixes_adj {F M K : Subfield ℂ} (σ : FieldAut F M) (hKM : K.le M) {x : ℂ} (hx : x ∈ M)
    (hK : σ.Fixes K) (hσx : σ.toFun ⟨x, hx⟩ = ⟨x, hx⟩) : σ.Fixes (adj K x) := by
  have hle : (adj K x).le (fixedField M (fun τ => τ = σ)) :=
    adj_le (fun y hy => ⟨hKM y hy, fun τ hτ => by rw [hτ]; exact hK ⟨y, hKM y hy⟩ hy⟩)
      (fun _ => ⟨hx, fun τ hτ => by rw [hτ]; exact hσx⟩)
  intro y hy
  obtain ⟨_, hf⟩ := hle y.1 hy
  exact hf σ rfl

/-- **Preimage of a subfield** under an embedding `τ : N → ℂ`: the elements of `N` that `τ`
sends into `M`. It is a subfield of `ℂ`. -/
def preimage {N : Subfield ℂ} (τ : RingHom N ℂ) (M : Subfield ℂ) : Subfield ℂ where
  carrier y := ∃ h : y ∈ N, τ.toFun ⟨y, h⟩ ∈ M
  zero_mem := ⟨N.zero_mem, by show τ.toFun 0 ∈ M; rw [τ.map_zero]; exact M.zero_mem⟩
  one_mem := ⟨N.one_mem, by show τ.toFun 1 ∈ M; rw [τ.map_one]; exact M.one_mem⟩
  add_mem := fun ⟨ha, ha'⟩ ⟨hb, hb'⟩ => ⟨N.add_mem ha hb, by
    show τ.toFun (⟨_, ha⟩ + ⟨_, hb⟩) ∈ M; rw [τ.map_add]; exact M.add_mem ha' hb'⟩
  neg_mem := fun ⟨ha, ha'⟩ => ⟨N.neg_mem ha, by
    show τ.toFun (-⟨_, ha⟩) ∈ M; rw [τ.map_neg]; exact M.neg_mem ha'⟩
  mul_mem := fun ⟨ha, ha'⟩ ⟨hb, hb'⟩ => ⟨N.mul_mem ha hb, by
    show τ.toFun (⟨_, ha⟩ * ⟨_, hb⟩) ∈ M; rw [τ.map_mul]; exact M.mul_mem ha' hb'⟩
  inv_mem := by
    intro a ⟨ha, ha'⟩ ha0
    obtain ⟨b, hb, hab⟩ := N.inv_mem ha ha0
    refine ⟨b, ⟨hb, ?_⟩, hab⟩
    have h1 : τ.toFun ⟨a, ha⟩ * τ.toFun ⟨b, hb⟩ = 1 := by
      rw [← τ.map_mul]
      have : (⟨a, ha⟩ : N) * ⟨b, hb⟩ = 1 := Subtype.ext hab
      rw [this, τ.map_one]
    have hne : τ.toFun ⟨a, ha⟩ ≠ 0 := fun h => by
      rw [h, Ring.zero_mul] at h1; exact C.isField.1 h1
    obtain ⟨w, hw, hw1⟩ := M.inv_mem ha' hne
    have : τ.toFun ⟨b, hb⟩ = w := by
      calc τ.toFun ⟨b, hb⟩ = τ.toFun ⟨b, hb⟩ * (τ.toFun ⟨a, ha⟩ * w) := by rw [hw1, Ring.mul_one]
        _ = (τ.toFun ⟨a, ha⟩ * τ.toFun ⟨b, hb⟩) * w := by ac_rfl
        _ = w := by rw [h1, Ring.one_mul]
    rw [this]; exact hw

end Foundations.Algebra
