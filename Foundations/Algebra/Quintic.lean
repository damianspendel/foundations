import Foundations.Algebra.GaloisCorrespondence

/-!
# Toward the insolvability of the quintic

Galois's criterion (1832) says: *a polynomial equation over a field of characteristic zero is
solvable by radicals if and only if its Galois group is solvable.* The classical example is
`x⁵ - 6x + 3` over `ℚ`. It is irreducible by Eisenstein's criterion at `3`. Calculus shows it has
exactly three real roots, so complex conjugation acts on its five roots as a transposition. Its
Galois group has order divisible by `5`, so by Cauchy's theorem it contains an element of order
`5`, a 5-cycle. A transposition and a 5-cycle generate `S₅`. So the Galois group is `S₅`, which is
not solvable, and the roots cannot be expressed by radicals.

**What this file proves (the group-theoretic half):**

* solvability passes to homomorphic images (`isSolvable_of_surjective`);
* consequently, **any group that maps onto `S₅` is not solvable**
  (`not_solvable_of_surjective_S5`). This applies to any Galois group `Aut(L/K)` isomorphic to
  `S₅`;
* **`S₅` is generated by the transposition `(0 1)` and the 5-cycle `(0 1 2 3 4)`**
  (`S5_generated`): every permutation of five letters is a product of these. Together with
  `symmetric_not_solvable`, this is the purely group-theoretic core of the argument above.

**What is *not* formalised in this Part (stated honestly):**

1. *Galois's criterion*, "solvable by radicals ⇒ solvable Galois group". This needs radical
   towers, roots of unity, cyclic Kummer extensions, normal closures, and the full Galois
   correspondence for normal subextensions. The previous file gives only Artin's half of the
   correspondence.
2. *The computation of the Galois group of `x⁵ - 6x + 3`*. This needs splitting fields inside
   `ℂ`, real numbers and the intermediate value theorem (three real roots), and the identification
   of the Galois group with a group of permutations of the roots. The relabelling step "an
   arbitrary transposition and an arbitrary 5-cycle generate `S₅`" is also not proved; only the
   normalised case `(0 1)`, `(0 1 2 3 4)` is.

So the theorem "the general quintic is not solvable by radicals" is reduced here to these two
field-theoretic inputs, which remain open in this project.


**Status update.** The relabelling lemma and the computation of the Galois group of
x⁵ − 6x + 3 (≅ S₅, hence not solvable) are now formalised in the later files
`S5Generation` … `QuinticGalois` (see `quintic_galois_not_solvable`). Galois's criterion
(solvable by radicals ⇒ solvable group) and the full Galois correspondence remain open.
-/

namespace Foundations.Algebra

open Group Perm

universe u v

/-! ## Solvability passes to quotients -/

/-- **Homomorphic images of the derived series.** If `f : G →* H` is surjective, every element of
the `k`-th derived subgroup of `H` is the image of an element of the `k`-th derived subgroup of
`G`. -/
theorem derivedSeries_surj {G : Type u} {H : Type v} [Group G] [Group H] (f : G →* H)
    (surj : ∀ y, ∃ x, f x = y) :
    ∀ k y, y ∈ derivedSeries H k → ∃ x, x ∈ derivedSeries G k ∧ f x = y := by
  intro k
  induction k with
  | zero => intro y _; obtain ⟨x, hx⟩ := surj y; exact ⟨x, trivial, hx⟩
  | succ k ih =>
    intro y hy
    induction hy with
    | of h =>
      obtain ⟨a, b, ha, hb, rfl⟩ := h
      obtain ⟨a', ha', rfl⟩ := ih a ha
      obtain ⟨b', hb', rfl⟩ := ih b hb
      refine ⟨commutator a' b', Closure.of ⟨a', b', ha', hb', rfl⟩, ?_⟩
      unfold commutator
      rw [f.map_mul', f.map_mul', f.map_mul', f.map_inv, f.map_inv]
    | one => exact ⟨1, Closure.one, f.map_one⟩
    | mul _ _ ih1 ih2 =>
      obtain ⟨x1, hx1, rfl⟩ := ih1
      obtain ⟨x2, hx2, rfl⟩ := ih2
      exact ⟨x1 * x2, Closure.mul hx1 hx2, f.map_mul' x1 x2⟩
    | inv _ ih1 =>
      obtain ⟨x1, hx1, rfl⟩ := ih1
      exact ⟨x1⁻¹, Closure.inv hx1, f.map_inv x1⟩

/-- **Quotients of solvable groups are solvable**: the image of a solvable group under a
surjective homomorphism is solvable. -/
theorem isSolvable_of_surjective {G : Type u} {H : Type v} [Group G] [Group H] (f : G →* H)
    (surj : ∀ y, ∃ x, f x = y) (hG : IsSolvable G) : IsSolvable H := by
  obtain ⟨k, hk⟩ := hG
  refine ⟨k, fun y hy => ?_⟩
  obtain ⟨x, hx, rfl⟩ := derivedSeries_surj f surj k y hy
  rw [hk x hx, f.map_one]

/-- **A group mapping onto `S₅` is not solvable.** In particular, a Galois group isomorphic to
`S₅` is not solvable, which by Galois's criterion (not formalised) means the corresponding
equation is not solvable by radicals. -/
theorem not_solvable_of_surjective_S5 {G : Type u} [Group G] (f : G →* Perm (Fin 5))
    (surj : ∀ y, ∃ x, f x = y) : ¬ IsSolvable G :=
  fun hG => symmetric_not_solvable (Nat.le_refl 5) (isSolvable_of_surjective f surj hG)

/-- A group isomorphic to `S₅` is not solvable. -/
theorem not_solvable_of_iso_S5 {G : Type u} [Group G] (e : G ≃* Perm (Fin 5)) : ¬ IsSolvable G :=
  not_solvable_of_surjective_S5 e.toHom e.surjective

/-! ## `S₅` is generated by a transposition and a 5-cycle -/

/-- The 5-cycle `(0 1 2 3 4)`, as the product `(0 1)(1 2)(2 3)(3 4)`. -/
def c5 : Perm (Fin 5) := swap 0 1 * swap 1 2 * swap 2 3 * swap 3 4

/-- The generators: `0 ↦ (0 1)`, `1 ↦ (0 1 2 3 4)`, `2 ↦ (0 1 2 3 4)⁻¹`. -/
def gen5 : Nat → Perm (Fin 5)
  | 0 => swap 0 1
  | 1 => c5
  | _ => c5⁻¹

/-- Words in the generators, for every transposition `(a b)`, found by breadth-first search. -/
def swapWords : List (List (List Nat)) :=
  [[[], [0], [0, 1, 0, 2, 0], [0, 1, 0, 1, 1, 0, 1], [2, 0, 1]],
   [[0], [], [1, 0, 2], [0, 2, 0, 2, 2, 0, 2], [0, 2, 0, 1, 0]],
   [[0, 1, 0, 2, 0], [1, 0, 2], [], [1, 1, 0, 2, 2], [1, 0, 1, 1, 0, 1, 1, 0, 1]],
   [[0, 1, 0, 1, 1, 0, 1], [0, 2, 0, 2, 2, 0, 2], [1, 1, 0, 2, 2], [], [2, 2, 0, 1, 1]],
   [[2, 0, 1], [0, 2, 0, 1, 0], [1, 0, 1, 1, 0, 1, 1, 0, 1], [2, 2, 0, 1, 1], []]]

/-- The word for the transposition `(a b)`. -/
def swapWord (a b : Fin 5) : List Nat := (swapWords.getD a.val []).getD b.val []

/-- **The finite verification**: each word evaluates to the corresponding transposition. -/
theorem swapWord_spec : ∀ a b : Fin 5, a ≠ b →
    ∀ x : Fin 5, (gprod ((swapWord a b).map gen5)) x = swap a b x := by decide

/-- **`S₅ = ⟨(0 1), (0 1 2 3 4)⟩`.** A subgroup of `S₅` containing the transposition `(0 1)` and
the 5-cycle `(0 1 2 3 4)` is all of `S₅`. -/
theorem S5_generated (H : Subgroup (Perm (Fin 5))) (ht : swap 0 1 ∈ H) (hc : c5 ∈ H) :
    ∀ σ, σ ∈ H := by
  have hgen : ∀ k, gen5 k ∈ H := by
    intro k
    match k with
    | 0 => exact ht
    | 1 => exact hc
    | _ + 2 => exact H.inv_mem hc
  have hswap : ∀ a b : Fin 5, a ≠ b → swap a b ∈ H := by
    intro a b hab
    have hw : gprod ((swapWord a b).map gen5) = swap a b := ext (swapWord_spec a b hab)
    rw [← hw]
    apply gprod_mem
    intro x hx
    obtain ⟨k, _, rfl⟩ := List.mem_map.1 hx
    exact hgen k
  intro σ
  obtain ⟨L, hL, rfl⟩ := transpositions_generate σ
  apply gprod_mem
  intro t ht'
  obtain ⟨a, b, hab, rfl⟩ := hL t ht'
  exact hswap a b hab

/-- **`S₅` is not solvable, via its generators.** A group of permutations of five letters that
contains `(0 1)` and `(0 1 2 3 4)` is all of `S₅`, and so is not solvable. This is the step
"transposition + 5-cycle ⇒ Galois group `S₅` ⇒ not solvable" in the classical proof. -/
theorem not_solvable_of_transposition_and_5cycle (H : Subgroup (Perm (Fin 5)))
    (ht : swap 0 1 ∈ H) (hc : c5 ∈ H) : ¬ IsSolvable H := by
  have hall := S5_generated H ht hc
  exact not_solvable_of_surjective_S5 (Hom.subtype H) fun y => ⟨⟨y, hall y⟩, rfl⟩

end Foundations.Algebra
