import Foundations.Sets.Paradoxes

/-!
# The Schröder–Bernstein theorem

Cantor measured the size of a collection by one-to-one correspondence: two
collections have the same size when their members can be paired off exactly.
"`α` is at most as large as `β`" then means: `α` can be injected into `β`. For
this to be a genuine *order* of sizes, it must be antisymmetric: if each of two
collections is at most as large as the other, they must have the same size.
That is the content of the **Schröder–Bernstein theorem** (Cantor conjectured
it; Dedekind, Schröder and Bernstein proved it in the 1880s–90s).

Proof idea. Given injections `f : α → β` and `g : β → α`, follow the "ancestry"
of each point of `α`. Call a point *Cantor-type* (`InC`) if, tracing back along
`g` and `f`, one eventually reaches a point of `α` not hit by `g`. Inductively:
points outside the range of `g` are in `InC`, and if `a` is in `InC` so is
`g (f a)`. On `InC` we use `f`; elsewhere we use the inverse of `g`, which is
available because points outside `InC` are in the range of `g`. Classical logic
is used to decide membership in `InC`.
-/

namespace Foundations.Sets

namespace SchroederBernstein

variable {α β : Type _} (f : α → β) (g : β → α)

/-- The points of `α` whose backward `g`/`f`-chain starts outside the range of `g`:
generated by the points not hit by `g`, and closed under `g ∘ f`. -/
inductive InC : α → Prop
  | base (a : α) : (¬ ∃ b, g b = a) → InC a
  | step (a : α) : InC a → InC (g (f a))

/-- A point not in `InC` lies in the range of `g`. -/
theorem range_of_not_inC {a : α} (h : ¬ InC f g a) : ∃ b, g b = a :=
  Classical.byContradiction fun hn => h (InC.base a hn)

/-- The Schröder–Bernstein map: `f` on `InC`, the inverse of `g` elsewhere. -/
noncomputable def sbMap (a : α) : β :=
  open Classical in
  if h : InC f g a then f a else Classical.choose (range_of_not_inC f g h)

/-- Off `InC`, `sbMap` is a left inverse of `g`: `g (sbMap a) = a`. -/
theorem g_sbMap_of_not {a : α} (h : ¬ InC f g a) : g (sbMap f g a) = a := by
  unfold sbMap
  simp only [h, ↓reduceDIte]
  exact Classical.choose_spec (range_of_not_inC f g h)

/-- On `InC`, `sbMap` agrees with `f`. -/
theorem sbMap_of_inC {a : α} (h : InC f g a) : sbMap f g a = f a := by
  unfold sbMap
  simp only [h, ↓reduceDIte]

/-- `sbMap` is injective. -/
theorem sbMap_injective (hf : Function.Injective f) : Function.Injective (sbMap f g) := by
  intro a₁ a₂ h
  by_cases h₁ : InC f g a₁ <;> by_cases h₂ : InC f g a₂
  · rw [sbMap_of_inC f g h₁, sbMap_of_inC f g h₂] at h
    exact hf h
  · exfalso
    apply h₂
    rw [← g_sbMap_of_not f g h₂, ← h, sbMap_of_inC f g h₁]
    exact InC.step a₁ h₁
  · exfalso
    apply h₁
    rw [← g_sbMap_of_not f g h₁, h, sbMap_of_inC f g h₂]
    exact InC.step a₂ h₂
  · rw [← g_sbMap_of_not f g h₁, ← g_sbMap_of_not f g h₂, h]

/-- `sbMap` is surjective. -/
theorem sbMap_surjective (hg : Function.Injective g) : Function.Surjective (sbMap f g) := by
  intro b
  by_cases hb : InC f g (g b)
  · -- `g b` is in `InC`; it is not a base point, so it is `g (f a)` with `a ∈ InC`
    have key : ∀ x, InC f g x → x = g b → ∃ a, InC f g a ∧ f a = b := by
      intro x hx
      cases hx with
      | base x hn => intro hx; exact absurd ⟨b, hx.symm⟩ hn
      | step a ha => intro hx; exact ⟨a, ha, hg hx⟩
    obtain ⟨a, ha, rfl⟩ := key (g b) hb rfl
    exact ⟨a, sbMap_of_inC f g ha⟩
  · exact ⟨g b, hg (g_sbMap_of_not f g hb)⟩

end SchroederBernstein

/-- **Schröder–Bernstein theorem.** If there are injections `α → β` and `β → α`,
then there is a bijection `α → β`. -/
theorem schroeder_bernstein {α β : Type _} {f : α → β} {g : β → α}
    (hf : Function.Injective f) (hg : Function.Injective g) : ∃ h : α → β, Bijective h :=
  ⟨SchroederBernstein.sbMap f g,
   SchroederBernstein.sbMap_injective f g hf, SchroederBernstein.sbMap_surjective f g hg⟩

end Foundations.Sets
