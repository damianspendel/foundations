import Foundations.Sets.OmegaArith
import Foundations.Numbers.Peano
import Foundations.Categories.ETCS

/-!
# Three natural numbers, one structure

Until now the parts of this project have stood side by side. Part I built the
von Neumann numbers `0 = ∅, 1 = {∅}, 2 = {∅, {∅}}, …` inside a model of
Zermelo–Fraenkel set theory and collected them into the set `ω`; Part II built
the Peano numbers `N` as a free-standing inductive type, generated by `zero` and
`succ`; and everywhere else Lean's own `Nat` was used, licensed by two separate
"bridge" theorems (`omega_bridge`, `N.bridge_nat`), each comparing one
construction with `Nat`. Part VII added a third, categorical, perspective: any
two *natural numbers objects* are uniquely isomorphic (`IsNNO.uniqueIso`), and
`N` and `Nat` are such objects (`peanoNatIso`).

This file makes the claim that these are *one* structure literal. We exhibit
explicit bijections

    ω  ≃  N  ≃  Nat

(between the *members* of the set `ω`, the Peano numbers, and Lean's numbers)
and prove that each preserves zero, successor, addition, multiplication and the
order — where on `ω` the operations are the purely set-theoretic `+ω` and `*ω`
defined by Dedekind's recursion theorem, and the order is inclusion `⊆`. We then
check the *coherence* of the bridges: going from `N` to `ω` and on to `Nat`
gives the same answer as Part II's direct translation, and the abstract
categorical comparison map of Part VII is, concretely, the very same function.
Finally, each of these maps is the *only* map preserving zero and successor —
Dedekind's categoricity theorem (1888), proved three times over.

Philosophically this is the precise sense in which Benacerraf's question "which
sets are the numbers?" has no answer and needs none: the three candidates are
not equal (one consists of sets of type `ZFSet`, one of inductive terms, one of
kernel-accelerated binary numerals), but they are isomorphic in exactly one
structure-preserving way, so any arithmetic statement true of one is true of the
others.
-/

namespace Foundations.Bridges

open Foundations.Sets Foundations.Sets.ZFSet Foundations.Numbers

universe u v w

/-! ## Bijections between types of any universe -/

/-- A **bijection with explicit inverse** between two types, which may live in
different universes (the members of `ω` form a type in `Type 1`, while `N` and
`Nat` live in `Type`). -/
structure Bij (α : Type u) (β : Type v) where
  /-- The forward map. -/
  toFun : α → β
  /-- The backward map. -/
  invFun : β → α
  /-- Forward then back is the identity. -/
  left_inv : ∀ a, invFun (toFun a) = a
  /-- Back then forward is the identity. -/
  right_inv : ∀ b, toFun (invFun b) = b

namespace Bij

/-- The inverse bijection. -/
def symm {α : Type u} {β : Type v} (e : Bij α β) : Bij β α :=
  ⟨e.invFun, e.toFun, e.right_inv, e.left_inv⟩

/-- The composite of two bijections. -/
def trans {α : Type u} {β : Type v} {γ : Type w} (e : Bij α β) (f : Bij β γ) : Bij α γ where
  toFun a := f.toFun (e.toFun a)
  invFun c := e.invFun (f.invFun c)
  left_inv a := by simp [f.left_inv, e.left_inv]
  right_inv c := by simp [e.right_inv, f.right_inv]

/-- The forward map of a bijection is injective. -/
theorem injective {α : Type u} {β : Type v} (e : Bij α β) : Function.Injective e.toFun :=
  fun a b h => by rw [← e.left_inv a, ← e.left_inv b, h]

/-- The forward map of a bijection is bijective in the sense of Part I. -/
theorem bijective {α : Type u} {β : Type v} (e : Bij α β) : Bijective e.toFun :=
  ⟨e.injective, fun b => ⟨e.invFun b, e.right_inv b⟩⟩

end Bij

/-! ## The members of ω as a structure -/

/-- The type of members of the set `ω` — the von Neumann natural numbers, viewed
as a type so that they can be compared with `N` and `Nat`. -/
abbrev Omega : Type 1 := {x : ZFSet // x ∈ ω}

namespace Omega

/-- Zero of `ω`: the empty set. -/
noncomputable def zero : Omega := ⟨∅, empty_mem_omega⟩

/-- Successor on `ω`: `x ↦ x ∪ {x}`. -/
noncomputable def succ (x : Omega) : Omega := ⟨ZFSet.succ x.1, succ_mem_omega x.2⟩

/-- Addition on `ω`: the set-theoretic `+ω` of `OmegaArith`, defined by recursion. -/
noncomputable def add (x y : Omega) : Omega := ⟨x.1 +ω y.1, addω_mem_omega x.2 y.2⟩

/-- Multiplication on `ω`: the set-theoretic `*ω` of `OmegaArith`. -/
noncomputable def mul (x y : Omega) : Omega := ⟨x.1 *ω y.1, mulω_mem_omega x.2 y.2⟩

/-- The order on `ω`: inclusion of sets. -/
def le (x y : Omega) : Prop := x.1 ⊆ y.1

/-- Every member of `ω` is some von Neumann numeral `vn n`. -/
theorem exists_vn (x : Omega) : ∃ n, x.1 = vn n := mem_omega.1 x.2

/-- The natural number named by a member of `ω` (chosen; unique by injectivity of `vn`). -/
noncomputable def toNat (x : Omega) : Nat := Classical.choose (exists_vn x)

/-- `x` is the numeral of `toNat x`. -/
theorem val_eq (x : Omega) : x.1 = vn (toNat x) := Classical.choose_spec (exists_vn x)

/-- `toNat` on the numeral `vn n` returns `n`. -/
theorem toNat_toOmega (n : Nat) : toNat (toOmega n) = n :=
  vn_injective (val_eq (toOmega n)).symm

/-- `toOmega` after `toNat` is the identity. -/
theorem toOmega_toNat (x : Omega) : toOmega (toNat x) = x :=
  Subtype.ext (val_eq x).symm

end Omega

/-! ## ω ≃ Nat -/

/-- **The bijection ω ≃ Nat**, with inverse `toOmega` (`n ↦ vn n`). -/
noncomputable def omegaNat : Bij Omega Nat :=
  ⟨Omega.toNat, toOmega, Omega.toOmega_toNat, Omega.toNat_toOmega⟩

/-- `toOmega` preserves zero. -/
theorem toOmega_zero : toOmega 0 = Omega.zero := rfl

/-- `toOmega` preserves successor. -/
theorem toOmega_succ (n : Nat) : toOmega (n + 1) = Omega.succ (toOmega n) := rfl

/-- `toOmega` preserves addition. -/
theorem toOmega_add (m n : Nat) : toOmega (m + n) = Omega.add (toOmega m) (toOmega n) :=
  Subtype.ext (vn_add m n)

/-- `toOmega` preserves multiplication. -/
theorem toOmega_mul (m n : Nat) : toOmega (m * n) = Omega.mul (toOmega m) (toOmega n) :=
  Subtype.ext (vn_mul m n)

/-- `toOmega` preserves and reflects the order. -/
theorem toOmega_le (m n : Nat) : m ≤ n ↔ Omega.le (toOmega m) (toOmega n) :=
  vn_subset_vn_iff.symm

/-- **ω and Nat are isomorphic structures.** The map `Omega.toNat : ω → Nat` is a
bijection sending `∅` to `0`, set-successor to `+1`, `+ω` to `+`, `*ω` to `*`, and
inclusion to `≤`. -/
theorem omega_nat_iso :
    Bijective omegaNat.toFun ∧
    omegaNat.toFun Omega.zero = 0 ∧
    (∀ x, omegaNat.toFun (Omega.succ x) = omegaNat.toFun x + 1) ∧
    (∀ x y, omegaNat.toFun (Omega.add x y) = omegaNat.toFun x + omegaNat.toFun y) ∧
    (∀ x y, omegaNat.toFun (Omega.mul x y) = omegaNat.toFun x * omegaNat.toFun y) ∧
    (∀ x y, Omega.le x y ↔ omegaNat.toFun x ≤ omegaNat.toFun y) := by
  have key : ∀ x : Omega, x = toOmega (Omega.toNat x) := fun x => (Omega.toOmega_toNat x).symm
  refine ⟨omegaNat.bijective, Omega.toNat_toOmega 0, fun x => ?_, fun x y => ?_,
    fun x y => ?_, fun x y => ?_⟩
  · show Omega.toNat _ = _
    conv => lhs; rw [key x, ← toOmega_succ]
    exact Omega.toNat_toOmega _
  · show Omega.toNat _ = _
    conv => lhs; rw [key x, key y, ← toOmega_add]
    exact Omega.toNat_toOmega _
  · show Omega.toNat _ = _
    conv => lhs; rw [key x, key y, ← toOmega_mul]
    exact Omega.toNat_toOmega _
  · show _ ↔ Omega.toNat x ≤ Omega.toNat y
    rw [toOmega_le, Omega.toOmega_toNat, Omega.toOmega_toNat]

/-! ## N ≃ ω -/

/-- The Peano–von Neumann translation `N → ω`: `zero ↦ ∅`, `succ n ↦ succ(image of n)`,
defined by structural recursion on the Peano numbers. -/
noncomputable def peanoToOmega : N → Omega
  | .zero => Omega.zero
  | .succ n => Omega.succ (peanoToOmega n)

/-- The recursive translation agrees with going through `Nat`. -/
theorem peanoToOmega_eq (n : N) : peanoToOmega n = toOmega (N.toNat n) := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [peanoToOmega, N.toNat, ih]; rfl

/-- **The bijection N ≃ ω** between Part II's Peano numbers and the members of
Part I's set `ω`. -/
noncomputable def peanoOmega : Bij N Omega where
  toFun := peanoToOmega
  invFun x := N.ofNat (Omega.toNat x)
  left_inv n := by rw [peanoToOmega_eq, Omega.toNat_toOmega]; exact N.equivNat.left_inv n
  right_inv x := by rw [peanoToOmega_eq, N.toNat_ofNat, Omega.toOmega_toNat]

/-- **N and ω are isomorphic structures.** The translation `N → ω` is a bijection
preserving zero, successor, addition, multiplication and order (Peano `≤` becomes
inclusion of sets). -/
theorem peano_omega_iso :
    Bijective peanoOmega.toFun ∧
    peanoOmega.toFun N.zero = Omega.zero ∧
    (∀ n, peanoOmega.toFun (N.succ n) = Omega.succ (peanoOmega.toFun n)) ∧
    (∀ a b, peanoOmega.toFun (a + b) = Omega.add (peanoOmega.toFun a) (peanoOmega.toFun b)) ∧
    (∀ a b, peanoOmega.toFun (a * b) = Omega.mul (peanoOmega.toFun a) (peanoOmega.toFun b)) ∧
    (∀ a b, a ≤ b ↔ Omega.le (peanoOmega.toFun a) (peanoOmega.toFun b)) := by
  refine ⟨peanoOmega.bijective, rfl, fun _ => rfl, fun a b => ?_, fun a b => ?_, fun a b => ?_⟩
  · show peanoToOmega (a + b) = Omega.add (peanoToOmega a) (peanoToOmega b)
    rw [peanoToOmega_eq, peanoToOmega_eq, peanoToOmega_eq, N.toNat_add, toOmega_add]
  · show peanoToOmega (a * b) = Omega.mul (peanoToOmega a) (peanoToOmega b)
    rw [peanoToOmega_eq, peanoToOmega_eq, peanoToOmega_eq, N.toNat_mul, toOmega_mul]
  · show _ ↔ Omega.le (peanoToOmega a) (peanoToOmega b)
    rw [peanoToOmega_eq, peanoToOmega_eq, ← toOmega_le, N.toNat_le]

/-! ## N ≃ Nat, and coherence -/

/-- Part II's direct bijection `N ≃ Nat`, repackaged as a `Bij`. -/
def peanoNat : Bij N Nat := ⟨N.toNat, N.ofNat, N.equivNat.left_inv, N.equivNat.right_inv⟩

/-- **Coherence of the natural-number bridges.** The triangle `N → ω → Nat`
commutes with Part II's direct translation `N → Nat`, in both directions: going
from the Peano numbers to the von Neumann numbers and on to Lean's numbers is the
same function as Part II's `toNat`, and the inverse composite is `ofNat`. -/
theorem nat_bridges_coherent :
    (peanoOmega.trans omegaNat).toFun = peanoNat.toFun ∧
    (peanoOmega.trans omegaNat).invFun = peanoNat.invFun := by
  constructor
  · funext n
    show Omega.toNat (peanoToOmega n) = N.toNat n
    rw [peanoToOmega_eq, Omega.toNat_toOmega]
  · funext n
    show N.ofNat (Omega.toNat (toOmega n)) = N.ofNat n
    rw [Omega.toNat_toOmega]

/-- The third side of the triangle: `ω → N → Nat` is `ω → Nat`. -/
theorem omega_peano_nat_coherent : (peanoOmega.symm.trans peanoNat).toFun = omegaNat.toFun := by
  funext x
  show N.toNat (N.ofNat (Omega.toNat x)) = Omega.toNat x
  exact N.toNat_ofNat _

/-! ## Connecting with the categorical comparison map of Part VII -/

open Foundations.Categories in
/-- **The categorical and the concrete bridge coincide.** Part VII's comparison
isomorphism `peanoNatIso : N ≅ Nat`, obtained abstractly from the universal property
of natural numbers objects (`IsNNO.uniqueIso`), is — as a function — exactly Part
II's hand-written translation `N.toNat`, and its inverse is `N.ofNat`. -/
theorem peanoNatIso_eq :
    (peanoNatIso.hom : N → Nat) = N.toNat ∧ (peanoNatIso.inv : Nat → N) = N.ofNat := by
  have hhom : (peanoNatIso.hom : N → Nat) = N.toNat := by
    symm
    exact IsNNO.uniqueIso_unique peanoNNO natNNO (N.toNat : N ⟶ Nat) rfl rfl
  refine ⟨hhom, ?_⟩
  have h := peanoNatIso.inv_hom_id
  funext n
  have : peanoNatIso.hom (peanoNatIso.inv n) = n := congrFun h n
  rw [hhom] at this
  calc peanoNatIso.inv n = N.ofNat (N.toNat (peanoNatIso.inv n)) :=
        (N.equivNat.left_inv _).symm
    _ = N.ofNat n := by rw [this]

/-! ## Categoricity: each bridge is the only one -/

/-- **Dedekind categoricity for ω.** Any map `ω → Nat` sending `∅` to `0` and
commuting with successor *is* `Omega.toNat`: the bridge is not a choice but forced. -/
theorem omega_nat_unique (f : Omega → Nat) (h0 : f Omega.zero = 0)
    (hs : ∀ x, f (Omega.succ x) = f x + 1) : f = omegaNat.toFun := by
  funext x
  rw [← Omega.toOmega_toNat x]
  show f (toOmega _) = Omega.toNat (toOmega _)
  rw [Omega.toNat_toOmega]
  induction Omega.toNat x with
  | zero => exact h0
  | succ n ih => rw [toOmega_succ, hs, ih]

/-- **Dedekind categoricity for N → ω.** Any map `N → ω` preserving zero and successor
is the translation `peanoToOmega`. -/
theorem peano_omega_unique (f : N → Omega) (h0 : f N.zero = Omega.zero)
    (hs : ∀ n, f (N.succ n) = Omega.succ (f n)) : f = peanoOmega.toFun := by
  funext n
  induction n with
  | zero => exact h0
  | succ n ih => rw [hs, ih]; rfl

end Foundations.Bridges
