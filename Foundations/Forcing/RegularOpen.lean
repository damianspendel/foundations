import Foundations.Forcing.BooleanAlgebra

/-!
# The regular-open algebra of a forcing poset

Cohen's forcing works with a partial order of **conditions**: pieces of finite information
about a generic object, where `p ≤ q` means "`p` extends `q`" (it says at least as much).
Two conditions are **compatible** if some condition extends both.

To pass from forcing to Boolean-valued models one needs a *complete* Boolean algebra in which
the poset sits densely. The standard choice is the algebra of **regular open sets**. Give
the poset the topology whose open sets are the downward-closed sets (if `p` is in, so is
every extension of `p`). In this topology the interior of the closure of a set `S` is
`{p | ∀ q ≤ p, ∃ r ≤ q, r ∈ S}`, "below every extension of `p` there is a point of `S`",
and an open set is **regular** when it equals the interior of its closure. Here we work
with this combinatorial description directly, without the general topology part of the
library:

* a regular open set is a downward-closed `U` such that if every extension of `p` has a
  further extension in `U`, then `p ∈ U`;
* meets are intersections; joins are the regularisation of unions;
* the complement of `U` is `{p | no extension of p lies in U}`.

The main theorem `RO.instCBA` shows that these regular open sets form a complete Boolean
algebra `RO P`. Distributivity and the law of the excluded middle `U ⊔ Uᶜ = ⊤`
are exactly where regularity is used: the union of `U` and its pseudo-complement is not
all of `P`, but it is *dense*, and its regularisation is everything.
-/

namespace Foundations.Forcing

universe u

/-- **Forcing notion.** A preorder of conditions; `p ≤ q` is read "`p` extends `q`", i.e.
`p` is the stronger condition. -/
class ForcingNotion (P : Type u) extends LE P where
  /-- Every condition extends itself. -/
  refl : ∀ p : P, p ≤ p
  /-- Extension is transitive. -/
  trans : ∀ p q r : P, p ≤ q → q ≤ r → p ≤ r

namespace ForcingNotion

variable {P : Type u} [ForcingNotion P]

/-- Two conditions are **compatible** if some condition extends both. -/
def Compatible (p q : P) : Prop := ∃ r, r ≤ p ∧ r ≤ q

/-- A family of conditions is an **antichain** if any two distinct members are
incompatible. -/
def IsAntichain (A : P → Prop) : Prop :=
  ∀ p q, A p → A q → p ≠ q → ¬ Compatible p q

/-- The **regularisation** `{p | ∀ q ≤ p, ∃ r ≤ q, r ∈ S}` of an arbitrary set `S` of
conditions: the interior of the closure of `S` in the downward topology. -/
def regClosure (S : P → Prop) : P → Prop := fun p => ∀ q, q ≤ p → ∃ r, r ≤ q ∧ S r

end ForcingNotion

open ForcingNotion

/-- **Regular open sets** of a forcing notion: downward-closed sets `U` such that whenever
every extension of `p` can be extended into `U`, already `p ∈ U`. -/
structure RO (P : Type u) [ForcingNotion P] where
  /-- The underlying set of conditions. -/
  carrier : P → Prop
  /-- Downward closure: extensions of members are members. -/
  down : ∀ p q, q ≤ p → carrier p → carrier q
  /-- Regularity: `U` contains every condition below which `U` is dense. -/
  reg : ∀ p, regClosure carrier p → carrier p

namespace RO

variable {P : Type u} [ForcingNotion P]

/-- Two regular open sets with the same members are equal. -/
theorem ext {U V : RO P} (h : ∀ p, U.carrier p ↔ V.carrier p) : U = V := by
  cases U with
  | mk c d r =>
    cases V with
    | mk c' d' r' =>
      have : c = c' := funext fun p => propext (h p)
      subst this; rfl

/-- The regularisation of any set is downward closed. -/
theorem regClosure_down (S : P → Prop) :
    ∀ p q, q ≤ p → regClosure S p → regClosure S q :=
  fun _ _ hqp h q' hq' => h q' (ForcingNotion.trans _ _ _ hq' hqp)

/-- The regularisation of any set is regular. -/
theorem regClosure_reg (S : P → Prop) : ∀ p, regClosure (regClosure S) p → regClosure S p := by
  intro p h q hq
  obtain ⟨r, hrq, hr⟩ := h q hq
  obtain ⟨r', hr'r, hr'⟩ := hr r (ForcingNotion.refl r)
  exact ⟨r', ForcingNotion.trans _ _ _ hr'r hrq, hr'⟩

/-- Every downward-closed set is contained in its regularisation. -/
theorem le_regClosure {S : P → Prop} (hS : ∀ p q, q ≤ p → S p → S q) {p : P} (hp : S p) :
    regClosure S p :=
  fun q hq => ⟨q, ForcingNotion.refl q, hS p q hq hp⟩

/-- The regular open set generated by an arbitrary set of conditions. -/
def ofSet (S : P → Prop) : RO P := ⟨regClosure S, regClosure_down S, regClosure_reg S⟩

/-- A regularisation lies inside any regular open set containing the original set. -/
theorem regClosure_le {S : P → Prop} {U : RO P} (h : ∀ p, S p → U.carrier p) {p : P}
    (hp : regClosure S p) : U.carrier p :=
  U.reg p fun q hq => by
    obtain ⟨r, hrq, hr⟩ := hp q hq
    exact ⟨r, hrq, h r hr⟩

/-- Order: inclusion. -/
instance : LE (RO P) := ⟨fun U V => ∀ p, U.carrier p → V.carrier p⟩

/-- Meet: intersection. -/
def inf (U V : RO P) : RO P where
  carrier p := U.carrier p ∧ V.carrier p
  down p q h hp := ⟨U.down p q h hp.1, V.down p q h hp.2⟩
  reg p h := ⟨U.reg p fun q hq => let ⟨r, hr, h'⟩ := h q hq; ⟨r, hr, h'.1⟩,
              V.reg p fun q hq => let ⟨r, hr, h'⟩ := h q hq; ⟨r, hr, h'.2⟩⟩

/-- Meet of an arbitrary family: intersection. -/
def sInf (S : RO P → Prop) : RO P where
  carrier p := ∀ U, S U → U.carrier p
  down p q h hp U hU := U.down p q h (hp U hU)
  reg p h U hU := U.reg p fun q hq => let ⟨r, hr, h'⟩ := h q hq; ⟨r, hr, h' U hU⟩

/-- Complement: the conditions none of whose extensions lies in `U`. -/
def compl (U : RO P) : RO P where
  carrier p := ∀ q, q ≤ p → ¬ U.carrier q
  down p q h hp q' hq' := hp q' (ForcingNotion.trans _ _ _ hq' h)
  reg p h q hq hU := by
    obtain ⟨r, hrq, hr⟩ := h q hq
    exact hr r (ForcingNotion.refl r) (U.down q r hrq hU)

/-- The top element: all conditions. -/
def top : RO P := ⟨fun _ => True, fun _ _ _ _ => trivial, fun _ _ => trivial⟩

/-- The bottom element: no conditions. -/
def bot : RO P where
  carrier _ := False
  down _ _ _ h := h
  reg p h := by obtain ⟨_, _, h'⟩ := h p (ForcingNotion.refl p); exact h'

/-- **The regular-open algebra is a complete Boolean algebra.** Joins are regularised
unions, meets are intersections, and the complement of `U` is the interior of its
set-theoretic complement. -/
instance instCBA : CompleteBooleanAlgebra (RO P) where
  inf := inf
  sup U V := ofSet fun p => U.carrier p ∨ V.carrier p
  compl := compl
  top := top
  bot := bot
  sSup S := ofSet fun p => ∃ U, S U ∧ U.carrier p
  sInf := sInf
  le_refl _ _ h := h
  le_trans _ _ _ h₁ h₂ p h := h₂ p (h₁ p h)
  le_antisymm _ _ h₁ h₂ := ext fun p => ⟨h₁ p, h₂ p⟩
  inf_le_left _ _ _ h := h.1
  inf_le_right _ _ _ h := h.2
  le_inf _ _ _ h₁ h₂ p h := ⟨h₁ p h, h₂ p h⟩
  le_sup_left U V _ h := le_regClosure (fun p q hq h => h.imp (U.down p q hq) (V.down p q hq)) (Or.inl h)
  le_sup_right U V _ h := le_regClosure (fun p q hq h => h.imp (U.down p q hq) (V.down p q hq)) (Or.inr h)
  sup_le U V W h₁ h₂ p hp := regClosure_le (fun q hq => hq.elim (h₁ q) (h₂ q)) hp
  le_top _ _ _ := trivial
  bot_le _ _ h := h.elim
  le_sSup S U hU p hp := le_regClosure (fun p q hq ⟨V, hV, h⟩ => ⟨V, hV, V.down p q hq h⟩) ⟨U, hU, hp⟩
  sSup_le S U h p hp := regClosure_le (fun q ⟨V, hV, hq⟩ => h V hV q hq) hp
  sInf_le S U hU p hp := hp U hU
  le_sInf S U h p hp V hV := h V hV p hp
  inf_sup_le U V W p hp q hq := by
    obtain ⟨r, hrq, hr⟩ := hp.2 q hq
    have hrU : U.carrier r := U.down p r (ForcingNotion.trans _ _ _ hrq hq) hp.1
    exact ⟨r, hrq, hr.elim (fun h => Or.inl ⟨hrU, h⟩) (fun h => Or.inr ⟨hrU, h⟩)⟩
  inf_compl_le_bot U p hp := hp.2 p (ForcingNotion.refl p) hp.1
  top_le_sup_compl U p _ q hq := by
    by_cases h : ∃ r, r ≤ q ∧ U.carrier r
    · obtain ⟨r, hrq, hr⟩ := h
      exact ⟨r, hrq, Or.inl hr⟩
    · exact ⟨q, ForcingNotion.refl q, Or.inr fun r hrq hr => h ⟨r, hrq, hr⟩⟩

end RO

end Foundations.Forcing
